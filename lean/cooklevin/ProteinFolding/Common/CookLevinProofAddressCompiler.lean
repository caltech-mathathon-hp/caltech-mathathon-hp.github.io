import ProteinFolding.Common.CookLevinProofArithmeticCompiler
import ProteinFolding.Common.TM2UnarySubtraction

/-! Actual polynomial TM2 generation of explicit arithmetic tableau addresses.
The encoded arguments are ((stackBound,time),(position,fixedDomainOffset)).
All constants belong to the fixed verifier machine; no input-dependent finite
enumeration is used by the address computation.
-/

namespace ProteinFolding.SAT.CookLevinAddressCompiler

open Computability Turing TM2CompositionPoly TM2ProductMap CookLevinArithmeticCompiler

noncomputable def addMaps {A : Type} {ea : FinEncoding A} {f g : A → ℕ}
    (hf : TM2ComputableInPolyTime ea unaryFinEncodingNat f)
    (hg : TM2ComputableInPolyTime ea unaryFinEncodingNat g) :
    TM2ComputableInPolyTime ea unaryFinEncodingNat (fun x => f x + g x) :=
  compose (pairComputable hf hg) additionComputable

noncomputable def multiplyMaps {A : Type} {ea : FinEncoding A} {f g : A → ℕ}
    (hf : TM2ComputableInPolyTime ea unaryFinEncodingNat f)
    (hg : TM2ComputableInPolyTime ea unaryFinEncodingNat g) :
    TM2ComputableInPolyTime ea unaryFinEncodingNat (fun x => f x * g x) :=
  compose (pairComputable hf hg) multiplicationComputable

noncomputable def subtractMaps {A : Type} {ea : FinEncoding A} {f g : A → ℕ}
    (hf : TM2ComputableInPolyTime ea unaryFinEncodingNat f)
    (hg : TM2ComputableInPolyTime ea unaryFinEncodingNat g) :
    TM2ComputableInPolyTime ea unaryFinEncodingNat (fun x => f x - g x) :=
  compose (pairComputable hf hg) TM2UnarySubtraction.subtractionComputable

abbrev IndexInput := (ℕ × ℕ) × (ℕ × ℕ)

def numberPairEncoding : FinEncoding (ℕ × ℕ) := pairEncoding unaryFinEncodingNat unaryFinEncodingNat

def indexEncoding : FinEncoding IndexInput := pairEncoding numberPairEncoding numberPairEncoding

noncomputable def stackProjection :
    TM2ComputableInPolyTime indexEncoding unaryFinEncodingNat (fun p => p.1.1) :=
  compose (TM2PairProjections.fstComputable numberPairEncoding numberPairEncoding)
    (TM2PairProjections.fstComputable unaryFinEncodingNat unaryFinEncodingNat)

noncomputable def timeProjection :
    TM2ComputableInPolyTime indexEncoding unaryFinEncodingNat (fun p => p.1.2) :=
  compose (TM2PairProjections.fstComputable numberPairEncoding numberPairEncoding)
    (TM2PairProjections.sndComputable unaryFinEncodingNat unaryFinEncodingNat)

noncomputable def positionProjection :
    TM2ComputableInPolyTime indexEncoding unaryFinEncodingNat (fun p => p.2.1) :=
  compose (TM2PairProjections.sndComputable numberPairEncoding numberPairEncoding)
    (TM2PairProjections.fstComputable unaryFinEncodingNat unaryFinEncodingNat)

noncomputable def offsetProjection :
    TM2ComputableInPolyTime indexEncoding unaryFinEncodingNat (fun p => p.2.2) :=
  compose (TM2PairProjections.sndComputable numberPairEncoding numberPairEncoding)
    (TM2PairProjections.sndComputable unaryFinEncodingNat unaryFinEncodingNat)

def address (base slope blockBase stride : ℕ) (p : IndexInput) : ℕ :=
  p.1.2 * (base + p.1.1 * slope) + (blockBase + (p.2.1 * stride + p.2.2))

/-- The complete arithmetic row/position address is generated by an actual
polynomial finite TM2 from its unary fields. -/
noncomputable def addressComputable (base slope blockBase stride : ℕ) :
    TM2ComputableInPolyTime indexEncoding unaryFinEncodingNat (address base slope blockBase stride) := by
  let hb := TM2Constants.constantComputable indexEncoding unaryFinEncodingNat base
  let hs := TM2Constants.constantComputable indexEncoding unaryFinEncodingNat slope
  let hp := TM2Constants.constantComputable indexEncoding unaryFinEncodingNat blockBase
  let hd := TM2Constants.constantComputable indexEncoding unaryFinEncodingNat stride
  let hw := addMaps hb (multiplyMaps stackProjection hs)
  let hr := multiplyMaps timeProjection hw
  let hc := addMaps hp (addMaps (multiplyMaps positionProjection hd) offsetProjection)
  exact addMaps hr hc

end ProteinFolding.SAT.CookLevinAddressCompiler
