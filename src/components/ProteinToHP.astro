---
/**
 * The front page's motivation figure: a protein in water with its H's packed in a core (left), an
 * arrow "keep one force", and a fold of an HP string on the cubic lattice with its contacts
 * (right). Drawn with the proof figures' kit (beads, sticks, contacts), so it looks like the game
 * and the proof board. Colours come from tokens.css through fig.css, so dark mode needs nothing.
 *
 * The protein is schematic: a chain on a triangular grid, turned, jittered and drawn with a smooth
 * stick, so that it looks off-lattice while no two beads overlap. Every H is in the core (the centre
 * and its six neighbours) and every node around the core is a P.
 *
 *   <ProteinToHP />
 */
import '../widgets/proof-map/figures/fig.css';
import Bead from '../widgets/proof-map/figures/kit/Bead.astro';
import Contact from '../widgets/proof-map/figures/kit/Contact.astro';
import { f } from '../widgets/proof-map/figures/kit/kit';
import { oblique, type P3, type Pt } from '../widgets/proof-map/figures/lib';

type HP = 'H' | 'P';

// ---------- left: a protein in water ----------
const core: Pt = [62, 68];
const step = 13.6; // distance between neighbouring nodes of the triangular grid
const turn = 0.32; // the grid is turned by this angle (radians), so that no row is level
// the chain, in axial coordinates (a, b) of the triangular grid: neighbours differ by
// (±1, 0), (0, ±1) or ±(1, −1)
const protein: [number, number, HP][] = [
  [-3, 0, 'P'], [-2, -1, 'P'], [-1, -1, 'P'], [0, -1, 'H'], [0, -2, 'P'], [1, -2, 'P'], [1, -1, 'H'],
  [2, -2, 'P'], [2, -1, 'P'], [1, 0, 'H'], [0, 0, 'H'], [-1, 0, 'H'], [-2, 0, 'P'], [-2, 1, 'P'],
  [-1, 1, 'H'], [-2, 2, 'P'], [-1, 2, 'P'], [0, 2, 'P'], [0, 1, 'H'], [1, 1, 'P'], [2, 0, 'P'], [3, 0, 'P'],
];
const [cos, sin] = [Math.cos(turn), Math.sin(turn)];
const beads = protein.map(([a, b, kind], i) => {
  const x = step * (a + b / 2);
  const y = step * ((b * Math.sqrt(3)) / 2);
  // a fixed small jitter and a radius that varies along the chain, as amino acids differ in size
  const jx = 1.1 * Math.sin(i * 2.39 + 0.7);
  const jy = 1.1 * Math.cos(i * 1.71 + 0.2);
  const r = 4.5 + 0.45 * Math.sin(i * 1.93 + 1.1);
  return { x: core[0] + x * cos - y * sin + jx, y: core[1] + x * sin + y * cos + jy, kind, r };
});
// a smooth stick through the beads (Catmull–Rom, as cubic Béziers)
const P = beads.map((b) => [b.x, b.y] as Pt);
const smooth = (p: Pt[]) => {
  let d = `M${f(p[0][0])},${f(p[0][1])}`;
  for (let i = 0; i < p.length - 1; i++) {
    const [p0, p1, p2, p3] = [p[Math.max(i - 1, 0)], p[i], p[i + 1], p[Math.min(i + 2, p.length - 1)]];
    const c1: Pt = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2: Pt = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${f(c1[0])},${f(c1[1])} ${f(c2[0])},${f(c2[1])} ${f(p2[0])},${f(p2[1])}`;
  }
  return d;
};
const proteinStick = smooth(P);

// ---------- right: a fold of PHHPHPPHPHHP on the cubic lattice, 5 contacts ----------
// Two layers z = 0 (front) and z = 1 (back) of a 2 × 3 block. The H's fill the middle row and the
// top of the right column.
const u = 31;
const pr = oblique(216, 106, u, 0.5, 0.5); // a back bead sits in the middle of a front square
const fold: [P3, HP][] = [
  [[1, 0, 0], 'P'], [[1, 1, 0], 'H'], [[1, 2, 0], 'H'], [[0, 2, 0], 'P'], [[0, 1, 0], 'H'], [[0, 0, 0], 'P'],
  [[0, 0, 1], 'P'], [[0, 1, 1], 'H'], [[0, 2, 1], 'P'], [[1, 2, 1], 'H'], [[1, 1, 1], 'H'], [[1, 0, 1], 'P'],
];
const rf = 7;
const touch = (a: P3, b: P3) => Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) + Math.abs(a[2] - b[2]) === 1;
const contacts: [P3, P3][] = [];
fold.forEach(([a, ka], i) =>
  fold.forEach(([b, kb], j) => {
    if (j > i + 1 && ka === 'H' && kb === 'H' && touch(a, b)) contacts.push([a, b]);
  }),
);
const bonds = fold.slice(1).map(([b], i) => [fold[i][0], b] as [P3, P3]);
// back to front: everything in the back layer, then what joins the layers, then the front layer
const layer = ([a, b]: [P3, P3]) => a[2] + b[2]; // 2 back, 1 between, 0 front
const segs = (z: number) => ({
  bonds: bonds.filter((s) => layer(s) === z),
  contacts: contacts.filter((s) => layer(s) === z),
});
const passes = [segs(2), segs(1), segs(0)];
const beadsAt = (z: number) => fold.filter(([p]) => p[2] === z).sort(([a], [b]) => a[1] - b[1] || a[0] - b[0]);

// ---------- labels ----------
const leftX = core[0];
const rightX = f(pr([0.5, 1, 0.5])[0]);
const arrow = { x1: 128, x2: 176, y: 76 };
---

<svg class="pmf pt" viewBox="0 0 320 168" role="img" aria-labelledby="pt-title">
  <title id="pt-title">On the left, a protein in water: a chain of beads that winds around itself, with its H beads packed together in the middle and its P beads around them. An arrow labelled "keep one force" points to the right, where a chain of twelve H's and P's is folded on the cubic lattice, two layers deep. Dashed lines join the five pairs of H's that touch without being neighbours in the chain.</title>
  <defs>
    <marker id="pt-arrowhead" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0.5 0.8 L7 4 L0.5 7.2" class="pt-arrowhead" />
    </marker>
  </defs>

  <circle class="pt-water" cx={core[0]} cy={core[1]} r="57" />
  <text class="pmf-label pt-water-label" x={core[0] - 54} y={core[1] - 44}>water</text>
  <circle class="pt-core" cx={core[0]} cy={core[1]} r="21" />
  <path class="pmf-stick" d={proteinStick} stroke-width="2.6" />
  {beads.map((b) => <Bead x={b.x} y={b.y} r={b.r} kind={b.kind} />)}

  <text class="pmf-label" x={(arrow.x1 + arrow.x2) / 2} y={arrow.y - 20} text-anchor="middle">keep one</text>
  <text class="pmf-label" x={(arrow.x1 + arrow.x2) / 2} y={arrow.y - 7} text-anchor="middle">force</text>
  <line class="pt-arrow" x1={arrow.x1} y1={arrow.y} x2={arrow.x2} y2={arrow.y} marker-end="url(#pt-arrowhead)" />

  {
    passes.map((pass, k) => (
      <g>
        {pass.bonds.map(([a, b]) => (
          <polyline class="pmf-stick" points={[pr(a), pr(b)].map(([x, y]) => `${f(x)},${f(y)}`).join(' ')} stroke-width={f(rf * 0.5)} />
        ))}
        {pass.contacts.map(([a, b]) => (
          <Contact a={pr(a)} b={pr(b)} r={rf} />
        ))}
        {k !== 1 && beadsAt(k === 0 ? 1 : 0).map(([p, kind]) => <Bead x={pr(p)[0]} y={pr(p)[1]} r={rf} kind={kind} />)}
      </g>
    ))
  }

  <text class="pmf-label-strong" x={leftX} y="148" text-anchor="middle">a protein</text>
  <text class="pmf-label" x={leftX} y="162" text-anchor="middle">H’s packed in a core</text>
  <text class="pmf-label-strong" x={rightX} y="148" text-anchor="middle">the HP model</text>
  <text class="pmf-label" x={rightX} y="162" text-anchor="middle">a fold on the cubic lattice</text>
</svg>

<style>
  .pt .pt-water {
    fill: color-mix(in srgb, var(--p) 11%, transparent);
  }
  .pt .pt-water-label {
    fill: color-mix(in srgb, var(--p) 75%, var(--fg-muted));
  }
  .pt .pt-core {
    fill: color-mix(in srgb, var(--h) 16%, transparent);
  }
  .pt .pt-arrow {
    stroke: var(--fg-muted);
    stroke-width: 1.3;
  }
  .pt .pt-arrowhead {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
