---
/**
 * A certificate's card: what Lean proves, the chain of reductions it checks (each step linked to
 * its declaration on GitHub when the project has a public address), the project's facts, and the
 * download. The chain comes from [[route]] in the certificate's settings.
 *
 *   <LeanCertificate />                                   the team's certificate
 *   <LeanCertificate cert="shelf" label="…" claim="…" how="…" labels={{ 'Perfect folding': '…' }} />
 *   <LeanCertificate provedIn={{ SAT: { cert: 'cooklevin', name: 'SAT.CookLevinUniversal.cookLevin' } }} />
 *                         a step the project assumes, drawn as proved and linked to its proof in another one
 */
import './lean.css';
import { asset, cert as getCert, date, decl, num, size } from './lean';

interface Props {
  cert?: string;
  /** A short line above the claim, naming the certificate. */
  label?: string;
  claim?: string;
  how?: string;
  /** Edge labels by the problem they lead to, in place of "proved in Lean". */
  labels?: Record<string, string>;
  /** What the project's vendor/ copy holds, for its line in the facts. */
  vendored?: string;
  /** Steps the project assumes but another certificate proves, by the problem they lead to. */
  provedIn?: Record<string, { cert: string; name: string }>;
}
const {
  cert = 'cubic',
  label,
  claim = 'Lean checks that HP folding on the cubic lattice is NP-complete, assuming the Cook–Levin theorem.',
  how = 'Each problem in the chain reduces to the next in polynomial time. Lean proves every step after the first, and that both folding problems are in NP.',
  labels = {},
  vendored = "the team's library",
  provedIn = {},
} = Astro.props;
const c = getCert(cert);
const route = c.route ?? [];
if (route.length === 0) throw new Error(`Lean page: the "${cert}" certificate has no [[route]].`);
const d = (name: string) => decl(name, cert);
/** The declaration a step links to, and whether it is still assumed. */
const via = (s: (typeof route)[number]) => {
  const other = provedIn[s.problem];
  return other ? { ...decl(other.name, other.cert), assumed: false } : { ...d(s.via!), assumed: !!s.assumed };
};
const edge = (s: (typeof route)[number]) =>
  labels[s.problem] ??
  (via(s).assumed ? (s.via === 'SAT.CookLevin' ? 'Cook–Levin, assumed' : 'assumed') : 'proved in Lean');

const p = c.project;
const clean = [p.sorries === 0 && 'no sorry', p.axioms === 0 && 'no axiom'].filter(Boolean).join(', ');
const facts = [
  `Lean ${p.lean}, mathlib ${p.mathlib}`,
  `${num(p.files)} files, ${num(p.lines)} lines`,
  p.excluded && `plus a copy of ${vendored} (${num(p.excluded.files)} files)`,
  clean,
  c.source.date && `version of ${date(c.source.date)}`,
].filter(Boolean);
---

<section class="ln ln-cert wide" aria-label={label ?? 'What Lean checks'}>
  <div class="ln-cert-head">
    {label && <p class="ln-cert-label">{label}</p>}
    <p class="ln-cert-claim">{claim}</p>
    <p class="ln-cert-how">{how}</p>
  </div>

  <ol class="ln-route" aria-label="The chain of reductions">
    {
      route.map((s, i) => (
        <li class:list={['ln-step', { 'is-goal': i === route.length - 1, 'is-start': !s.via }]}>
          {s.via && (
            <p class={`ln-via is-${via(s).assumed ? 'premise' : 'proved'}`}>
              <i class="ln-stick" aria-hidden="true" />
              {via(s).href ? (
                <a href={via(s).href} title={via(s).full}>
                  {edge(s)}
                </a>
              ) : (
                <span title={via(s).full}>{edge(s)}</span>
              )}
            </p>
          )}
          <p class="ln-node">
            <i class="ln-bead" aria-hidden="true" />
            <span class="ln-node-name">{s.problem}</span>
            {s.np &&
              (d(s.np).href ? (
                <a class="ln-np" href={d(s.np).href} title={d(s.np).full}>
                  in NP, proved
                </a>
              ) : (
                <span class="ln-np" title={d(s.np).full}>
                  in NP, proved
                </span>
              ))}
          </p>
        </li>
      ))
    }
  </ol>

  <div class="ln-cert-foot">
    <ul class="ln-facts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
    <p class="ln-links">
      <a class="btn primary" href={asset(c.download.path)} download>
        <span>Download the Lean project</span>
        <span class="ln-btn-note">zip, {size(c.download.bytes)}</span>
      </a>
      {c.links.tree && <a class="btn ghost" href={c.links.tree}>Read it on GitHub</a>}
    </p>
  </div>
</section>
