---
/**
 * The top of the Lean page: what Lean proves, the chain of reductions it checks (each step
 * linked to its declaration on GitHub), the project's facts, and the download.
 *
 *   <LeanCertificate />
 */
import './lean.css';
import { asset, date, decl, lean, num, size, type Status } from './lean';

interface Step {
  name: string;
  /** How the previous problem reduces to this one. */
  via?: { status: Extract<Status, 'proved' | 'premise'>; decl: string };
  /** The declaration proving the problem is in NP. */
  np?: string;
  goal?: boolean;
}
const steps: Step[] = [
  { name: 'Every problem in NP' },
  { name: 'SAT', via: { status: 'premise', decl: 'SAT.CookLevin' } },
  { name: '3D matching', via: { status: 'proved', decl: 'ThreeDimensionalMatching.cnfToBlockMatching_karp' } },
  { name: 'Bin packing', via: { status: 'proved', decl: 'MatchingPacking.matching_karpReduces_modified' } },
  {
    name: 'Perfect folding',
    via: { status: 'proved', decl: 'CubicPacking.packingToPerfect_karp' },
    np: 'perfectHPStringFold_inNP',
  },
  { name: 'HP folding', via: { status: 'proved', decl: 'perfect_karpReduces_hp' }, np: 'hpStringFold_inNP', goal: true },
];

const p = lean.project;
const clean = [p.sorries === 0 && 'no sorry', p.axioms === 0 && 'no axiom'].filter(Boolean).join(', ');
const facts = [
  `Lean ${p.lean}, mathlib ${p.mathlib}`,
  `${num(p.files)} files, ${num(p.lines)} lines`,
  clean,
  lean.source.date && `version of ${date(lean.source.date)}`,
].filter(Boolean);
---

<section class="ln ln-cert wide" aria-label="What Lean checks">
  <div class="ln-cert-head">
    <p class="ln-cert-claim">
      Lean checks that HP folding on the cubic lattice is NP-complete, assuming the Cook–Levin theorem.
    </p>
    <p class="ln-cert-how">
      Each problem in the chain reduces to the next in polynomial time. Lean proves every step after
      the first, and that both folding problems are in NP.
    </p>
  </div>

  <ol class="ln-route" aria-label="The chain of reductions">
    {
      steps.map((s) => (
        <li class:list={['ln-step', { 'is-goal': s.goal, 'is-start': !s.via }]}>
          {s.via && (
            <p class={`ln-via is-${s.via.status}`}>
              <i class="ln-stick" aria-hidden="true" />
              <a href={decl(s.via.decl).href} title={decl(s.via.decl).full}>
                {s.via.status === 'premise' ? 'Cook–Levin, assumed' : 'proved in Lean'}
              </a>
            </p>
          )}
          <p class="ln-node">
            <i class="ln-bead" aria-hidden="true" />
            <span class="ln-node-name">{s.name}</span>
            {s.np && (
              <a class="ln-np" href={decl(s.np).href} title={decl(s.np).full}>
                in NP, proved
              </a>
            )}
          </p>
        </li>
      ))
    }
  </ol>

  <div class="ln-cert-foot">
    <ul class="ln-facts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
    <p class="ln-links">
      <a class="btn primary" href={asset(lean.download.path)} download>
        <span>Download the Lean project</span>
        <span class="ln-btn-note">zip, {size(lean.download.bytes)}</span>
      </a>
      <a class="btn ghost" href={lean.links.tree}>Read it on GitHub</a>
    </p>
  </div>
</section>
