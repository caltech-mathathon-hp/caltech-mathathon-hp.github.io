---
/**
 * Shell commands for checking the Lean project, built from certificate.json so the URLs, the
 * branch and the folder names stay in one place.
 *
 *   <LeanCommands step="zip" />     unzip the download
 *   <LeanCommands step="git" />     clone the branch instead
 *   <LeanCommands step="build" />   fetch mathlib, build, print the main theorems and their axioms
 *   <LeanCommands step="verify" />  the project's full audit (PowerShell 7)
 */
import { Code } from 'astro:components';
import './lean.css';
import { lean, zipFolder } from './lean';

interface Props {
  step: 'zip' | 'git' | 'build' | 'verify';
}
const { step } = Astro.props;
const zip = lean.download.path.split('/').pop();
const repoDir = lean.links.clone.split('/').pop()!.replace(/\.git$/, '');
const code = {
  zip: `unzip ${zip}\ncd ${zipFolder}`,
  git: `git clone --branch ${lean.links.branch} --single-branch ${lean.links.clone}\ncd ${repoDir}/${lean.source.path}`,
  build: 'lake exe cache get\nlake build\nlake env lean checks/CubicHardness.lean',
  verify: 'pwsh -NoProfile -File checks/Verify.ps1',
}[step];
---

<div class="ln ln-cmd">
  <Code code={code} lang="sh" theme="css-variables" class="ln-codeblock" />
</div>
