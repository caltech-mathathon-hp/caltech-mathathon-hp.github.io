---
/**
 * Lean formalization status, rendered from src/data/lean.yaml (server-side only).
 * <LeanStatus />
 */
import lean from '../../data/lean.yaml';

type Item = { id: string; title: string; status: 'planned' | 'in-progress' | 'verified' | 'prose'; file?: string };
const items: Item[] = lean.items ?? [];
const p = lean.project ?? {};
const label = { planned: 'Planned', 'in-progress': 'In progress', verified: 'Lean-verified', prose: 'On paper' };
const counts = items.reduce<Record<string, number>>((acc, i) => ((acc[i.status] = (acc[i.status] ?? 0) + 1), acc), {});
const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<div class="lean wide">
  <div class="lean-head ui">
    <div>
      <div class="lean-k">Toolchain</div>
      <div>{p.toolchain || '—'}</div>
    </div>
    <div>
      <div class="lean-k">Commit</div>
      <div><code>{p.commit || 'none yet'}</code></div>
    </div>
    <div>
      <div class="lean-k">Progress</div>
      <div>{counts['verified'] ?? 0} of {items.filter((i) => i.status !== 'prose').length} verified</div>
    </div>
    <div class="lean-actions">
      {
        p.download ? (
          <a class="btn primary" href={p.download}>Download the Lean project</a>
        ) : (
          <button class="btn" disabled title="Available when the Lean project is published">No download yet</button>
        )
      }
      {p.repo && <a class="btn ghost" href={p.repo}>Browse the source</a>}
    </div>
  </div>

  <table class="lean-table">
    <thead>
      <tr><th>Statement</th><th>Status</th><th class="lean-file">Lean file</th></tr>
    </thead>
    <tbody>
      {
        items.map((i) => (
          <tr>
            <td set:html={code(i.title)} />
            <td><span class={`lean-st ${i.status}`}>{label[i.status] ?? i.status}</span></td>
            <td class="lean-file">{i.file ? <code>{i.file}</code> : <span class="muted">—</span>}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <div class="lean-cols">
    <div>
      <h3>What “Lean-verified” means</h3>
      <ul>{(lean.guarantees ?? []).map((g: string) => <li set:html={code(g)} />)}</ul>
    </div>
    <div>
      <h3>How to build</h3>
      <pre><code>{lean.build}</code></pre>
    </div>
  </div>
</div>

<style>
  .lean {
    margin: var(--s-5) 0;
  }
  .lean-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--s-4);
    align-items: end;
    padding: var(--s-4) var(--s-5);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }
  .lean-k {
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin-bottom: var(--s-1);
  }
  .lean-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    justify-content: flex-end;
  }
  .lean-st {
    --c: var(--fg-subtle);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 0.3em 0.55em;
    border-radius: 999px;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    background: color-mix(in srgb, var(--c) 9%, transparent);
    white-space: nowrap;
  }
  .lean-st.verified { --c: var(--st-lean); }
  .lean-st.in-progress { --c: var(--st-draft); }
  .lean-st.prose { --c: var(--st-cited); }
  .lean-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--s-6);
  }
  .lean-cols h3 {
    margin-top: var(--s-4);
  }
  .lean-cols ul {
    font-size: var(--fs-sm);
  }
  @media (max-width: 40rem) {
    .lean-file {
      display: none;
    }
    .lean-actions {
      justify-content: flex-start;
    }
  }
</style>
