---
/**
 * A project's own index (docs/theorem-index.md): each statement of the paper, the Lean
 * declarations that state or prove it, and its status.
 *
 *   <LeanIndex />                 the team's certificate
 *   <LeanIndex cert="shelf" paper="Our paper" />
 *   <LeanIndex cookLevin={{ cert: 'cooklevin', name: 'SAT.CookLevinUniversal.cookLevin' }} />
 *       Cook–Levin is proved in the certificate cooklevin: rows proved assuming it count as
 *       proved, and the row that states it links to its proof.
 */
import './lean.css';
import Dot from './Dot.astro';
import { cert as getCert, decl } from './lean';

interface Props {
  /** The certificate's id (default "cubic"). */
  cert?: string;
  /** The first column's heading. */
  paper?: string;
  /** Where Cook–Levin is proved, when the index's own project takes it as a hypothesis. */
  cookLevin?: { cert: string; name: string };
}
const { cert = 'cubic', paper = 'In the paper', cookLevin } = Astro.props;
const c = getCert(cert);
const own = (n: string) => ({ name: n, href: c.decls[n]?.href });
const proof = cookLevin && { name: cookLevin.name, href: decl(cookLevin.name, cookLevin.cert).href };
const assumesCL = (r: (typeof c.index)[number]) => r.status === 'premise' && r.names.includes('SAT.CookLevin');
const rows = c.index.map((r) => {
  const names = r.names.map(own);
  if (proof && assumesCL(r)) return { ...r, names: [...names, proof], status: 'proved' as const };
  if (proof && r.status === 'conditional') return { ...r, names, status: 'proved' as const };
  return { ...r, names };
});
---

<div class="ln ln-table-wrap wide">
  <table class="ln-table">
    <thead>
      <tr>
        <th scope="col">{paper}</th>
        <th scope="col" class="ln-col-lean">In Lean</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>
              {r.concept}
              <span class="ln-names ln-names-narrow">
                {r.names.map((n) => (n.href ? <a href={n.href}><code>{n.name}</code></a> : <code>{n.name}</code>))}
              </span>
            </td>
            <td class="ln-col-lean">
              <span class="ln-names">
                {r.names.map((n) => (n.href ? <a href={n.href}><code>{n.name}</code></a> : <code>{n.name}</code>))}
              </span>
            </td>
            <td>
              <Dot status={r.status} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
