---
/**
 * A project's own index (docs/theorem-index.md): each statement of the paper, the Lean
 * declarations that state or prove it, and its status.
 *
 *   <LeanIndex />                 the team's certificate
 *   <LeanIndex cert="shelf" paper="Our paper" />
 */
import './lean.css';
import Dot from './Dot.astro';
import { cert as getCert } from './lean';

interface Props {
  /** The certificate's id (default "cubic"). */
  cert?: string;
  /** The first column's heading. */
  paper?: string;
}
const { cert = 'cubic', paper = 'In the paper' } = Astro.props;
const c = getCert(cert);
const link = (n: string) => c.decls[n]?.href;
---

<div class="ln ln-table-wrap wide">
  <table class="ln-table">
    <thead>
      <tr>
        <th scope="col">{paper}</th>
        <th scope="col" class="ln-col-lean">In Lean</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        c.index.map((r) => (
          <tr>
            <td>
              {r.concept}
              <span class="ln-names ln-names-narrow">
                {r.names.map((n) => (link(n) ? <a href={link(n)}><code>{n}</code></a> : <code>{n}</code>))}
              </span>
            </td>
            <td class="ln-col-lean">
              <span class="ln-names">
                {r.names.map((n) => (link(n) ? <a href={link(n)}><code>{n}</code></a> : <code>{n}</code>))}
              </span>
            </td>
            <td>
              <Dot status={r.status} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
