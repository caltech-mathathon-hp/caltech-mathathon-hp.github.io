---
/**
 * The project's own index (docs/theorem-index.md): each statement of the paper, the Lean
 * declarations that state or prove it, and its status.
 *
 *   <LeanIndex />
 */
import './lean.css';
import Dot from './Dot.astro';
import { lean } from './lean';

const link = (n: string) => lean.decls[n]?.href;
---

<div class="ln ln-table-wrap wide">
  <table class="ln-table">
    <thead>
      <tr>
        <th scope="col">In the paper</th>
        <th scope="col" class="ln-col-lean">In Lean</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        lean.index.map((r) => (
          <tr>
            <td>
              {r.concept}
              <span class="ln-names ln-names-narrow">
                {r.names.map((n) => (link(n) ? <a href={link(n)}><code>{n}</code></a> : <code>{n}</code>))}
              </span>
            </td>
            <td class="ln-col-lean">
              <span class="ln-names">
                {r.names.map((n) => (link(n) ? <a href={link(n)}><code>{n}</code></a> : <code>{n}</code>))}
              </span>
            </td>
            <td>
              <Dot status={r.status} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
