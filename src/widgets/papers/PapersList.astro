---
/**
 * The list of every paper on the Context page, grouped by main theme (a paper's first theme),
 * most relevant first. Rendered on the server, so it works without JavaScript, and it is what
 * <Cite> links to: each entry has id="paper-<key>".
 *
 * An entry shows a relevance marker, the byline, the title (linked to the paper) and a one-clause
 * gist. The gist is the <summary> of a <details> that holds the longer takeaway, why it matters,
 * the connections, the venue and how far we read it.
 *
 * A small script (1) opens the entry that the URL hash points to, on load and on hash changes,
 * and (2) shows a "Show on the map" button, which sets the hash and sends a 'pp:select' event
 * that PapersMap.tsx listens for.
 *
 * Data: src/data/papers/papers.json (generated by scripts/build_papers.py).
 */
import raw from '../../data/papers/papers.json';
import { shortAuthors, type PapersData } from '../../data/papers/types';
import { buildLinks, bylineAuthors, joinAuthors, relLabel, RELEVANCE, statusLine } from './labels';
import './styles.css';

const data = raw as unknown as PapersData;
const byKey = new Map(data.papers.map((p) => [p.key, p]));
const links = buildLinks(data);
const groups = data.themes
  .map((t) => ({
    theme: t,
    papers: data.papers
      .filter((p) => p.themes[0] === t.id)
      .sort((a, b) => b.relevance - a.relevance || a.year - b.year || a.key.localeCompare(b.key)),
  }))
  .filter((g) => g.papers.length > 0);
const colorOf = (id: string) => `var(${data.themes.find((t) => t.id === id)?.color ?? '--fg-muted'})`;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// The last word of a gist is kept on one line with the open/close chevron.
const gistHead = (g: string) => g.slice(0, g.lastIndexOf(' ') + 1);
const gistTail = (g: string) => g.slice(g.lastIndexOf(' ') + 1);
---

<div class="pp-refs">
  <p class="pp-refs-key">
    <span><span class="pp-ref-mark" aria-hidden="true">{RELEVANCE[3].mark}</span> central to our question</span>
    <span><span class="pp-ref-mark" aria-hidden="true">{RELEVANCE[2].mark}</span> relevant</span>
    <span>Open a summary line for details.</span>
  </p>
  {
    groups.map(({ theme, papers }) => (
      <section class="pp-refs-theme" aria-labelledby={`papers-${theme.id}`}>
        <h3 class="pp-refs-head" id={`papers-${theme.id}`}>
          <span class="pp-dot" style={`--c: ${colorOf(theme.id)}`} aria-hidden="true" />
          {theme.label}
          <span class="pp-chip-n">{papers.length}</span>
        </h3>
        {theme.description && <p class="pp-refs-desc">{theme.description}</p>}
        <ol class="pp-refs-list">
          {papers.map((p) => {
            const ls = links.get(p.key) ?? [];
            const rel = RELEVANCE[p.relevance];
            const truncated = bylineAuthors(p.authors) !== joinAuthors(p.authors);
            const meta = [truncated ? joinAuthors(p.authors) : '', p.venue ?? ''].filter(Boolean).join('. ');
            return (
              <li id={`paper-${p.key}`} class="pp-ref">
                <span class="pp-ref-mark" title={rel.mark ? rel.label : undefined} aria-hidden="true">
                  {rel.mark}
                </span>
                <div class="pp-ref-body">
                  <p class="pp-ref-cite">
                    {rel.mark && <span class="visually-hidden">{rel.label}. </span>}
                    <span class="pp-ref-by">
                      {bylineAuthors(p.authors)} ({p.year}).
                    </span>{' '}
                    {p.url ? (
                      <a class="pp-ref-title" href={p.url} target="_blank" rel="noopener noreferrer">
                        {p.title}
                      </a>
                    ) : (
                      <span class="pp-ref-title">{p.title}</span>
                    )}
                  </p>
                  <details class="pp-ref-more">
                    <summary class="pp-ref-gist">
                      {gistHead(p.gist)}
                      <span class="pp-ref-tail">{gistTail(p.gist)}</span>
                    </summary>
                    <div class="pp-ref-detail">
                      {p.takeaway && <p>{p.takeaway}</p>}
                      {p.why && (
                        <p class="pp-ref-why">
                          <span class="pp-ref-label">Why it matters.</span> {p.why}
                        </p>
                      )}
                      {ls.length > 0 && (
                        <div class="pp-ref-rel">
                          <p class="pp-ref-label">Connections</p>
                          <ul>
                            {ls.map((l) => {
                              const o = byKey.get(l.other)!;
                              return (
                                <li>
                                  {cap(relLabel(l))} <a href={`#paper-${o.key}`}>{`${shortAuthors(o)} (${o.year})`}</a>
                                  {l.note && <span class="pp-ref-note">{l.note}</span>}
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      )}
                      <p class="pp-ref-meta">
                        {meta && <span>{meta}.</span>}
                        <span>{statusLine(p)}</span>
                        <button type="button" class="pp-ref-show" data-key={p.key} hidden>
                          Show on the map
                        </button>
                      </p>
                    </div>
                  </details>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</div>

<script>
  // Open the entry the URL hash points to (a <Cite> link, the map's "Show in the list", a connection).
  function openFromHash() {
    const m = /^#paper-(.+)$/.exec(decodeURIComponent(location.hash));
    const entry = m && document.getElementById(`paper-${m[1]}`);
    const more = entry?.querySelector<HTMLDetailsElement>('details.pp-ref-more');
    if (more) more.open = true;
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // "Show on the map" selects the paper in the interactive map, when the page has one.
  function showOnMap(key: string) {
    history.replaceState(null, '', `#paper-${key}`);
    window.dispatchEvent(new CustomEvent('pp:select', { detail: { key } }));
    const map = document.getElementById('papers-map');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    map?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }
  if (document.getElementById('papers-map')) {
    document.querySelectorAll<HTMLButtonElement>('.pp-ref-show').forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', () => showOnMap(b.dataset.key ?? ''));
    });
  }
</script>
