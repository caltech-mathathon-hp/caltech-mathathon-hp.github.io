---
/**
 * Footnote 7 of Berger–Leighton in cross-section, drawn with the kit: the plane through one row of
 * the front face, seen from above, with the edge of the cube seen end-on at (0, 0).
 * i runs to the right along the front face, k downward into the cube (cube: i ≥ 0, k ≥ 0), drawn on
 * the cube's pale face colour; its other H's are faded.
 * The last H of a long rod sits on the edge; its P before it is at (0, −1) (grey: the rod's P's fill
 * the nodes in front of the edge); the six P's of `P P^4 P` (the rod's last P, P^4, the first P of
 * the wall) go round that P to the first H of the wall at (1, 0), which touches the rod's last H.
 */
import './fig.css';
import Bead from './kit/Bead.astro';
import Strand from './kit/Strand.astro';
import Contact from './kit/Contact.astro';

type Pt = [number, number];
const c = 34;
const r = 10;
const X = (i: number) => 56 + (i + 1) * c;
const Y = (k: number) => 24 + (k + 2) * c;
const at = ([i, k]: Pt): Pt => [X(i), Y(k)];

const rodP: Pt = [0, -1];
const rodH: Pt = [0, 0];
const route: Pt[] = [[-1, 0], [-1, -1], [-1, -2], [0, -2], [1, -2], [1, -1]];
const wall: { p: Pt; t: 'H' | 'P' }[] = [
  { p: [1, 0], t: 'H' },
  { p: [2, 0], t: 'H' },
  { p: [2, -1], t: 'P' },
  { p: [3, -1], t: 'P' },
  { p: [3, 0], t: 'H' },
  { p: [4, 0], t: 'H' },
  { p: [4, -1], t: 'P' },
];
const chain: Pt[] = [rodP, rodH, ...route, ...wall.map((w) => w.p)];
const inside: Pt[] = [];
for (let k = 1; k <= 2; k++) for (let i = 0; i <= 4; i++) inside.push([i, k]);
const x0 = X(-0.5);
const x1 = X(4.7);
const y0 = Y(-0.5);
const y1 = Y(2.6);
const edgeAt = at(rodH);
---

<svg class="pmf pmf-six-ps" viewBox="0 0 320 206" role="img" aria-labelledby="pmf-six-ps-t">
  <title id="pmf-six-ps-t">A cross-section through one row of the front face, with the edge seen end-on; the cube's other H's in this plane are drawn faded. The last H of a long rod sits on the edge, with one of the rod's P's, drawn grey, in front of it. Six P's, numbered 1 to 6, go round that P and end in front of the face node next to the edge, where the first H of the wall sits, touching the rod's last H. The wall runs on along the front face.</title>
  <rect class="pmf-slab" x={x0} y={y0} width={x1 - x0} height={y1 - y0} />
  <line class="pmf-slab-edge" x1={x0} y1={y0} x2={x1} y2={y0} />
  <line class="pmf-slab-edge" x1={x0} y1={y0} x2={x0} y2={y1} />
  {inside.map((p) => <Bead x={at(p)[0]} y={at(p)[1]} r={r} kind="H" dim />)}

  <Strand pts={chain.map(at)} r={r} to={[X(4.55), Y(-1)]} bare />
  <Contact a={at(rodH)} b={at([1, 0])} r={r} />
  <Bead x={at(rodP)[0]} y={at(rodP)[1]} r={r} kind="P" color="var(--fg-subtle)" />
  <Bead x={edgeAt[0]} y={edgeAt[1]} r={r} kind="H" />
  {wall.map((w) => <Bead x={at(w.p)[0]} y={at(w.p)[1]} r={r} kind={w.t} />)}
  {
    route.map((p, n) => (
      <g>
        <Bead x={at(p)[0]} y={at(p)[1]} r={r} kind="P" />
        <text class="pmf-six-ps-num" x={at(p)[0]} y={at(p)[1] + 3.8} text-anchor="middle">{n + 1}</text>
      </g>
    ))
  }

  <text class="pmf-label" x={x1 + 6} y={y0 + 4}>front face</text>
  <text class="pmf-label" x={X(4) + r + 7} y={Y(0) + 4}>wall</text>
  <text class="pmf-label" x={x0} y={y1 + 15} text-anchor="middle">left face</text>
  <text class="pmf-label-sm" x={X(2.5)} y={y1 + 15} text-anchor="middle">inside the cube</text>
  <polyline class="pmf-lead" points={`${edgeAt[0] - r * 0.75},${edgeAt[1] + r * 0.75} ${X(-1.1)},${Y(0.85)}`} />
  <text class="pmf-label" x={X(-1.1) - 2} y={Y(0.85) + 13} text-anchor="middle">edge</text>
</svg>

<style>
  .pmf-six-ps {
    max-width: 24rem;
    margin-inline: auto;
  }
  .pmf-six-ps-num {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 650;
    fill: var(--fg);
  }
</style>
