---
/**
 * Footnote 7 of Berger–Leighton in cross-section: the plane through one row of the front face,
 * seen from above, with the edge of the cube seen end-on at (0, 0).
 * i runs to the right along the front face, k downward into the cube (cube: i ≥ 0, k ≥ 0).
 * The last H of a long rod sits on the edge; its P before it is at (0, −1); the six P's of
 * `P P^4 P` (the rod's last P, P^4, the first P of the wall) go round that P to the first H of the
 * wall at (1, 0).
 */
const c = 34;
const X = (i: number) => 18 + (i + 2) * c;
const Y = (k: number) => 22 + (k + 3) * c;
const xy = (i: number, k: number) => `${X(i)},${Y(k)}`;

const route: [number, number][] = [[-1, 0], [-1, -1], [-1, -2], [0, -2], [1, -2], [1, -1]];
const wallH: [number, number][] = [[1, 0], [2, 0], [3, 0], [4, 0]];
const wallP: [number, number][] = [[2, -1], [3, -1], [4, -1]];
const chain: [number, number][] = [[0, -1], [0, 0], ...route, [1, 0], [2, 0], [2, -1], [3, -1], [3, 0], [4, 0], [4, -1]];
const dots: [number, number][] = [];
for (let i = 0; i <= 4; i++) for (let k = 1; k <= 2; k++) dots.push([i, k]);
---

<svg class="pmf-six" viewBox="0 0 322 234" role="img" aria-labelledby="pmf-six-t">
  <title id="pmf-six-t">A cross-section through one row of the front face, with the edge seen end-on. The last H of a long rod sits on the edge, with one of its P's in front of it. Six P's, numbered 1 to 6, go round that P and end in front of the face node next to the edge, where the first H of the wall sits.</title>
  <rect class="pmf-cube" x={X(-0.5)} y={Y(-0.5)} width={X(4.7) - X(-0.5)} height={Y(2.6) - Y(-0.5)} />
  <line class="pmf-surface" x1={X(-0.5)} y1={Y(-0.5)} x2={X(4.7)} y2={Y(-0.5)} />
  <line class="pmf-surface" x1={X(-0.5)} y1={Y(-0.5)} x2={X(-0.5)} y2={Y(2.6)} />
  {dots.map(([i, k]) => <circle class="pmf-dot" cx={X(i)} cy={Y(k)} r="2" />)}
  <line class="pmf-bond" x1={X(0)} y1={Y(0)} x2={X(1)} y2={Y(0)} />
  <polyline class="pmf-chain" points={chain.map(([i, k]) => xy(i, k)).join(' ')} />
  <circle class="pmf-p pmf-own" cx={X(0)} cy={Y(-1)} r="9" />
  {wallP.map(([i, k]) => <circle class="pmf-p" cx={X(i)} cy={Y(k)} r="7" />)}
  {
    route.map(([i, k], n) => (
      <g>
        <circle class="pmf-p" cx={X(i)} cy={Y(k)} r="9" />
        <text class="pmf-num" x={X(i)} y={Y(k) + 3.5} text-anchor="middle">{n + 1}</text>
      </g>
    ))
  }
  <circle class="pmf-h" cx={X(0)} cy={Y(0)} r="8" />
  {wallH.map(([i, k]) => <circle class="pmf-h" cx={X(i)} cy={Y(k)} r="8" />)}
  <text class="pmf-label" x={X(4.7) + 6} y={Y(-0.5) + 4}>front face</text>
  <text class="pmf-label" x={X(-0.5)} y={Y(2.6) + 15} text-anchor="middle">left face</text>
  <text class="pmf-label" x={X(-0.5) - 8} y={Y(0.5) + 12} text-anchor="end">edge</text>
  <text class="pmf-label" x={X(2.5)} y={Y(0) + 24} text-anchor="middle">wall</text>
  <text class="pmf-label pmf-in" x={X(2.5)} y={Y(1.5) + 4} text-anchor="middle">inside the cube</text>
</svg>

<style>
  .pmf-six {
    display: block;
    width: 100%;
    max-width: 24rem;
    height: auto;
    margin-inline: auto;
  }
  .pmf-cube {
    fill: var(--bg-sunk);
  }
  .pmf-surface {
    stroke: var(--rule-strong);
    stroke-width: 1.5;
  }
  .pmf-dot {
    fill: var(--lattice);
  }
  .pmf-chain {
    fill: none;
    stroke: var(--backbone);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .pmf-bond {
    stroke: var(--bond);
    stroke-width: 2.5;
    stroke-dasharray: 4 3;
  }
  .pmf-h {
    fill: var(--h);
  }
  .pmf-p {
    fill: var(--bg);
    stroke: var(--p);
    stroke-width: 2;
  }
  .pmf-own {
    stroke: var(--fg-subtle);
    stroke-dasharray: 3 2;
  }
  .pmf-num {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    fill: var(--fg);
  }
  .pmf-label {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--fg-muted);
  }
  .pmf-in {
    fill: var(--fg-subtle);
  }
</style>
