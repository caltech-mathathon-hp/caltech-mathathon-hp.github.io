---
/**
 * Card "The crossbar" (BL Lemmas 3.3–3.8), drawn for h = 3. The layers of the crossbar, seen face
 * on, at the depths where its stages meet. The h × h inputs are packed; a fan-out spreads them to
 * every other node (layer 2h − 2); three stages permute them within rows, within columns, within
 * rows (Lemma 3.6, routed by Lemma 3.7: layers 4h − 3, 6h − 4, 8h − 5); a fan-in packs them again
 * (layer 10h − 7). Three ends are tracked in the item colours; lines join their places.
 */
import './fig.css';
import Tx from './Tx.astro';
import { itemColor, type Pt } from './lib';

const h = 3;
const cx = [22, 76, 130, 184, 238, 292];
const cy = 64;
const tight = 9.5;
const wide = 7.5;
/** Place (row r, column c) of an end in layer i: packed in the first and last layer, spread between. */
const at = (i: number, r: number, c: number): Pt => {
  const packed = i === 0 || i === cx.length - 1;
  const p = packed ? tight : 2 * wide;
  return [cx[i] + (c - (h - 1) / 2) * p, cy + (r - (h - 1) / 2) * p];
};
/* Three tracked ends: [row, column] in each layer. */
const tracks: [number, number][][] = [
  [[0, 0], [0, 0], [0, 2], [2, 2], [2, 1], [2, 1]],
  [[2, 1], [2, 1], [2, 0], [0, 0], [0, 2], [0, 2]],
  [[1, 2], [1, 2], [1, 1], [1, 1], [1, 0], [1, 0]],
];
const all: [number, number][] = [];
for (let r = 0; r < h; r++) for (let c = 0; c < h; c++) all.push([r, c]);
const spreadGrid: [number, number][] = [];
for (let r = 0; r < 2 * h - 1; r++) for (let c = 0; c < 2 * h - 1; c++) spreadGrid.push([r / 2, c / 2]);
const half = (i: number) => (i === 0 || i === cx.length - 1 ? tight : 2 * wide) * ((h - 1) / 2) + 6;
const stages = ['spread', 'rows', 'columns', 'rows', 'gather'];
const depths = ['0', '2h − 2', '4h − 3', '6h − 4', '8h − 5', '10h − 7'];
const axisY = 110;
---

<svg class="pmf" viewBox="0 0 320 170" role="img" aria-labelledby="pmf-xbar-t">
  <title id="pmf-xbar-t">The switchboard (the paper's crossbar), drawn for h = 3: six layers seen face on, from the h by h inputs at depth 0 to the outputs at depth 10h − 7. Between depth 0 and 2h − 2 the ends spread out to every other node. Three stages then permute them within rows, within columns, and within rows again, ending at depths 4h − 3, 6h − 4 and 8h − 5. Between 8h − 5 and 10h − 7 they gather again into an h by h array, now in the new order. Three ends are coloured, with lines from each place to the next.</title>
  {
    stages.map((s, i) => (
      <text class="pmf-label" x={(cx[i] + cx[i + 1]) / 2} y="22" text-anchor="middle">
        {s}
      </text>
    ))
  }
  {
    cx.map((x, i) => (
      <rect class="pmf-face" x={x - half(i)} y={cy - half(i)} width={2 * half(i)} height={2 * half(i)} rx="2" />
    ))
  }
  {
    cx.slice(1, -1).map((_, j) =>
      spreadGrid.map(([r, c]) => {
        const [x, y] = at(j + 1, r, c);
        return <circle class="pmf-dot" cx={x} cy={y} r="1.5" />;
      }),
    )
  }
  {
    tracks.map((t, k) =>
      t.slice(1).map((rc, i) => {
        const [x1, y1] = at(i, ...t[i]);
        const [x2, y2] = at(i + 1, ...rc);
        return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke-width="1.6" style={`stroke:${itemColor(k)}`} />;
      }),
    )
  }
  {
    cx.map((_, i) =>
      all.map(([r, c]) => {
        const k = tracks.findIndex((t) => t[i][0] === r && t[i][1] === c);
        const [x, y] = at(i, r, c);
        return k < 0 ? <circle class="pmf-p" cx={x} cy={y} r="2.9" stroke-width="1.3" /> : <circle cx={x} cy={y} r="3.8" style={`fill:${itemColor(k)}`} />;
      }),
    )
  }
  <line class="pmf-edge-line" x1={cx[0]} y1={axisY} x2={cx.at(-1)} y2={axisY} />
  {cx.map((x) => <line class="pmf-edge-line" x1={x} y1={axisY - 4} x2={x} y2={axisY + 4} />)}
  {depths.map((d, i) => <Tx x={cx[i]} y={axisY + 18} t={d} a="middle" />)}
  <text class="pmf-label" x={cx[0] - 14} y={axisY + 38}>inputs</text>
  <text class="pmf-label" x={(cx[0] + cx.at(-1)!) / 2} y={axisY + 38} text-anchor="middle">depth</text>
  <text class="pmf-label" x={cx.at(-1)! + 14} y={axisY + 38} text-anchor="end">outputs</text>
  <Tx x={cx[0] - 14} y={axisY + 54} t="drawn for h = 3" />
</svg>
