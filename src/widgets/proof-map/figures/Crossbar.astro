---
/**
 * Card "Untangling the linkers" (BL Lemmas 3.3–3.8), drawn for h = 3. The switchboard cut at the
 * depths where its stages meet, each layer seen face on as a pale blue square. The h × h inputs are
 * packed; a spreading stage takes them to every other node (depth 2h − 2); three rounds permute
 * them within rows, within columns, within rows (Lemma 3.6, routed by Lemma 3.7: depths 4h − 3,
 * 6h − 4, 8h − 5); a gathering stage packs them again (depth 10h − 7).
 * All nine ends are routed (a permutation built by the three rounds, below); one end is followed at
 * full strength, the others are faded. Ends are P's (hollow beads); empty nodes are small dots.
 */
import './fig.css';
import Tx from './Tx.astro';
import Bead from './kit/Bead.astro';
import Nodes from './kit/Nodes.astro';
import { f } from './kit/kit';
import type { Pt } from './lib';

const h = 3;
const cx = [22, 76, 130, 184, 238, 292];
const cy = 66;
const tight = 9.5; // node spacing of a packed layer
const wide = 7.5; // node spacing of a spread layer: the ends sit on every other node
const r = 3;
const packed = (i: number) => i === 0 || i === cx.length - 1;
/** Place (row, column) of an end in layer i. */
const at = (i: number, [row, col]: [number, number]): Pt => {
  const p = packed(i) ? tight : 2 * wide;
  return [cx[i] + (col - (h - 1) / 2) * p, cy + (row - (h - 1) / 2) * p];
};
const half = (i: number) => (packed(i) ? tight : 2 * wide) * ((h - 1) / 2) + 6.5;

/* The nine ends, by their input place: their place after the first round (rows), the second
   (columns) and the third (rows). The first one is followed. */
type RC = [number, number];
const ends: { from: RC; rounds: [RC, RC, RC] }[] = [
  { from: [0, 0], rounds: [[0, 2], [2, 2], [2, 1]] },
  { from: [2, 1], rounds: [[2, 0], [0, 0], [0, 2]] },
  { from: [1, 2], rounds: [[1, 1], [1, 1], [1, 0]] },
  { from: [0, 1], rounds: [[0, 0], [1, 0], [1, 2]] },
  { from: [0, 2], rounds: [[0, 1], [2, 1], [2, 0]] },
  { from: [1, 0], rounds: [[1, 0], [2, 0], [2, 2]] },
  { from: [1, 1], rounds: [[1, 2], [0, 2], [0, 1]] },
  { from: [2, 0], rounds: [[2, 2], [1, 2], [1, 1]] },
  { from: [2, 2], rounds: [[2, 1], [0, 1], [0, 0]] },
];
/** Places of an end in the six layers: input, spread, three rounds, gathered. */
const placesOf = (e: (typeof ends)[number]): RC[] => [e.from, e.from, ...e.rounds, e.rounds[2]];
const pathOf = (e: (typeof ends)[number]) => {
  const p = placesOf(e).map((rc, i) => at(i, rc));
  return (
    `M${f(p[0][0])} ${f(p[0][1])}` +
    p
      .slice(1)
      .map(([x, y], i) => {
        const [x0, y0] = p[i];
        const d = (x - x0) / 2;
        return `C${f(x0 + d)} ${f(y0)} ${f(x - d)} ${f(y)} ${f(x)} ${f(y)}`;
      })
      .join('')
  );
};
const [lead, ...rest] = ends;
const start = at(0, lead.from);
/* Empty nodes of the spread layers: the (2h − 1)² grid less the ends. */
const dots: Pt[] = [];
for (let i = 1; i < cx.length - 1; i++)
  for (let a = 0; a < 2 * h - 1; a++)
    for (let b = 0; b < 2 * h - 1; b++)
      if (a % 2 || b % 2) dots.push([cx[i] + (b - (h - 1)) * wide, cy + (a - (h - 1)) * wide]);
const stages = ['spread', 'rows', 'columns', 'rows', 'gather'];
const depths = ['0', '2h − 2', '4h − 3', '6h − 4', '8h − 5', '10h − 7'];
const axisY = 112;
---

<svg class="pmf" viewBox="0 0 320 172" role="img" aria-labelledby="pmf-crossbar-t">
  <title id="pmf-crossbar-t">The switchboard, drawn for h = 3, cut at six depths: each cut is a pale blue square seen face on, with the ends as hollow P beads. At depth 0 the h by h inputs are packed. Between depth 0 and 2h − 2 the ends spread out to every other node. Three rounds then move them within rows, within columns, and within rows again, ending at depths 4h − 3, 6h − 4 and 8h − 5. Between 8h − 5 and 10h − 7 they gather again into an h by h square, now in the new order. One end is followed by a solid curve: it moves along its row, then along its column, then along its row; the routes of the other eight are faded.</title>
  {
    stages.map((s, i) => (
      <text class="pmf-label" x={(cx[i] + cx[i + 1]) / 2} y="20" text-anchor="middle">
        {s}
      </text>
    ))
  }
  {cx.map((x, i) => <rect class="pmf-board" x={x - half(i)} y={cy - half(i)} width={2 * half(i)} height={2 * half(i)} rx="4" />)}
  <Nodes pts={dots} r={r} />
  <g class="pmf-crossbar-faded">
    {rest.map((e) => <path class="pmf-crossbar-route" d={pathOf(e)} />)}
  </g>
  <path class="pmf-crossbar-band" d={pathOf(lead)} />
  <path class="pmf-crossbar-route is-lead" d={pathOf(lead)} />
  {rest.flatMap((e) => placesOf(e).map((rc, i) => at(i, rc))).map(([x, y]) => <Bead x={x} y={y} r={r} kind="P" dim />)}
  {placesOf(lead).map((rc, i) => at(i, rc)).map(([x, y]) => <Bead x={x} y={y} r={r} kind="P" />)}
  <text class="pmf-label-p" x="4" y={start[1] - 19}>one end</text>
  <path class="pmf-lead" d={`M${start[0]} ${start[1] - 15}V${start[1] - r - 2}`} />

  <line class="pmf-edge-line" x1={cx[0]} y1={axisY} x2={cx.at(-1)} y2={axisY} />
  {cx.map((x) => <line class="pmf-edge-line" x1={x} y1={axisY - 4} x2={x} y2={axisY + 4} />)}
  {depths.map((d, i) => <Tx x={cx[i]} y={axisY + 18} t={d} a="middle" />)}
  <text class="pmf-label" x={cx[0] - 14} y={axisY + 38}>inputs</text>
  <text class="pmf-label" x={(cx[0] + cx.at(-1)!) / 2} y={axisY + 38} text-anchor="middle">depth</text>
  <text class="pmf-label" x={cx.at(-1)! + 14} y={axisY + 38} text-anchor="end">outputs</text>
  <Tx x={cx[0] - 14} y={axisY + 56} t="drawn for h = 3" />
</svg>

<style>
  .pmf-crossbar-route {
    fill: none;
    stroke: var(--p);
    stroke-width: 1;
    stroke-linecap: round;
  }
  .pmf-crossbar-route.is-lead {
    stroke-width: 1.8;
  }
  .pmf-crossbar-faded {
    opacity: 0.4;
  }
  .pmf-crossbar-band {
    fill: none;
    stroke: var(--p);
    stroke-opacity: 0.16;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
