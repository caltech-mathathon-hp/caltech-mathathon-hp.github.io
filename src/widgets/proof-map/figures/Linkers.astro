---
/**
 * Card "Loops take up slack" (BL pp. 36–37), drawn like the explainer video: the cube below, its
 * front face edge on, with the item ribbons of strip 1 (6 + 4) and strip 2 (2 + 8), story/items.ts.
 * The linker from the last H of item 6 to the first H of item 2, in another strip, is followed:
 * from each end 4 P's go straight out, the switchboard (pale blue) routes the two runs until they
 * come out side by side, and there they join, after a loop out and back that makes the linker
 * exactly 52n + 2 P's long. Faded: the linkers from 2 to 8 and from 8 to 4, whose loops have other
 * lengths, since their routes do. Routes cross in the picture but lie at different depths.
 */
import './fig.css';
import Tx from './Tx.astro';
import Strand from './kit/Strand.astro';
import { N } from './notation';
import { itemColor, type Pt } from './lib';
import { f } from './kit/kit';
import { ITEMS, inBin } from './story/items';

const s = 11;
const r = 3.3;
const X = (m: number) => 20 + m * s; // columns of the picture
const Fy = 184; // the front face
const boxTop = 96;
const boxBot = 134;
const outY = 89; // the outputs, just past the switchboard
const strips = [0, 15]; // first column of strip 1 and strip 2
/* The item ribbons, in the order of the strip: [item, first column]. */
const ribbons = [0, 1].flatMap((b) => {
  let m = strips[b];
  return inBin(b).map((k) => {
    const at = m;
    m += ITEMS[k];
    return { k, m: at };
  });
});
const ribbon = (k: number) => ribbons.find((x) => x.k === k)!;
const lastOf = (k: number) => ribbon(k).m + ITEMS[k] - 1;
const firstOf = (k: number) => ribbon(k).m;
/* Linkers between consecutive items of the string: ends (columns), outputs (a pair of columns),
   and the length of the loop in P's per side. The first is the one followed. */
const linkers = [
  { from: lastOf(0), to: firstOf(1), out: 10, loop: 4 },
  { from: lastOf(1), to: firstOf(2), out: 18, loop: 5 },
  { from: lastOf(2), to: firstOf(3), out: 14, loop: 3 },
].map((l) => {
  const up = (m: number): Pt[] => [1, 2, 3, 4].map((i) => [X(m), Fy - i * s]);
  const a = X(l.out);
  const b = X(l.out + 1);
  const loop: Pt[] = [
    ...Array.from({ length: l.loop }, (_, i): Pt => [a, outY - i * s]),
    ...Array.from({ length: l.loop }, (_, i): Pt => [b, outY - (l.loop - 1 - i) * s]),
  ];
  const route = (x0: number, x1: number) => {
    const ym = (boxTop + boxBot) / 2;
    return `M${f(x0)} ${Fy - 4 * s}C${f(x0)} ${ym} ${f(x1)} ${ym} ${f(x1)} ${outY}`;
  };
  return { ...l, upA: up(l.from), upB: up(l.to), loop, routes: [route(X(l.from), a), route(X(l.to), b)] };
});
const [lead, ...rest] = linkers;
const loopTop = outY - (lead.loop.length / 2 - 1) * s;
/** The followed linker as one line, for the pale band behind it. */
const band =
  `M${X(lead.from)} ${Fy}V${Fy - 4 * s}` +
  lead.routes[0].replace(/^M[^C]*/, '') +
  `V${loopTop}H${X(lead.out + 1)}V${outY}` +
  `C${X(lead.out + 1)} ${(boxTop + boxBot) / 2} ${X(lead.to)} ${(boxTop + boxBot) / 2} ${X(lead.to)} ${Fy - 4 * s}V${Fy}`;
---

<svg class="pmf" viewBox="0 0 320 224" role="img" aria-labelledby="pmf-linkers-t">
  <title id="pmf-linkers-t">A side view: the cube below, its front face seen edge on, with the items 6 and 4 in strip 1 and the items 2 and 8 in strip 2. The linker from the last H of item 6 to the first H of item 2 is followed: four P's go straight out from each end, the switchboard routes the two runs until they come out side by side, and there they join, after a loop out and back that makes the linker exactly 52n + 2 P's long. The linkers from 2 to 8 and from 8 to 4 are faded; their loops have other lengths.</title>
  <rect class="pmf-slab" x="4" y={Fy} width="312" height="38" rx="3" />
  <line class="pmf-slab-edge" x1="4" y1={Fy} x2="316" y2={Fy} />
  <rect class="pmf-board" x="8" y={boxTop} width="304" height={boxBot - boxTop} rx="5" />
  <text class="pmf-label-accent" x="15" y={(boxTop + boxBot) / 2 + 4}>switchboard</text>

  <path class="pmf-linkers-band" d={band} />
  <g class="is-dim">
    {rest.flatMap((l) => l.routes).map((d) => <path class="pmf-linkers-route" d={d} />)}
    {rest.map((l) => (
      <>
        <Strand pts={l.upA} from={[X(l.from), Fy]} kinds="P" r={r} />
        <Strand pts={l.upB} from={[X(l.to), Fy]} kinds="P" r={r} />
        <Strand pts={l.loop} kinds="P" r={r} />
      </>
    ))}
  </g>
  {lead.routes.map((d) => <path class="pmf-linkers-route is-lead" d={d} />)}
  <Strand pts={lead.upA} from={[X(lead.from), Fy]} kinds="P" r={r} />
  <Strand pts={lead.upB} from={[X(lead.to), Fy]} kinds="P" r={r} />
  <Strand pts={lead.loop} kinds="P" r={r} />

  {
    ribbons.map(({ k, m }) => (
      <>
        {Array.from({ length: ITEMS[k] / 2 }, (_, i) => (
          <Strand pts={[[X(m + 2 * i), Fy], [X(m + 2 * i + 1), Fy]]} item k={k} r={r} />
        ))}
        <text class="pmf-linkers-size" x={(X(m) + X(m + ITEMS[k] - 1)) / 2} y={Fy + 15} text-anchor="middle" style={`fill:${itemColor(k)}`}>{ITEMS[k]}</text>
      </>
    ))
  }
  {strips.map((m, b) => <Tx x={(X(m) + X(m + 9)) / 2} y={Fy + 30} t={`${N.strip} ${b + 1}`} a="middle" />)}
  <text class="pmf-label" x="8" y={Fy - 7}>front face</text>

  <text class="pmf-label" x={X(lead.from) - 8} y={Fy - 2.5 * s + 4} text-anchor="end">4 P's</text>
  <text class="pmf-label" x={X(lead.to) - 8} y={Fy - 2.5 * s + 4} text-anchor="end">4 P's</text>
  <text class="pmf-label-p" x={X(lead.out) - 9} y={outY + 4} text-anchor="end">ends side by side</text>
  <text class="pmf-label-p" x={X(lead.out) - 9} y={loopTop + 4} text-anchor="end">loop: the P's left over</text>
  <Tx x="312" y="20" t={`each ${N.linker}: ${N.linkerLen} P's in all`} a="end" />
</svg>

<style>
  .pmf-linkers-route {
    fill: none;
    stroke: var(--p);
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .pmf-linkers-route.is-lead {
    stroke-width: 1.9;
  }
  .pmf-linkers-band {
    fill: none;
    stroke: var(--p);
    stroke-opacity: 0.15;
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pmf-linkers-size {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 650;
  }
</style>
