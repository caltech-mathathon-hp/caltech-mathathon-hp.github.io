---
/**
 * A legend: one row per entry, a small sample on the left and its meaning on the right, like the
 * explainer video's. Kinds: H, P, pad, plug, item (with k, or ks for several), node, contact,
 * stick (two H's joined), group (a ring), text (no sample).
 *
 *   <Legend x={10} y={150} rows={[{ kind: 'pad', label: 'padding' }, { kind: 'node', label: 'empty node' }]} />
 */
import Bead from './Bead.astro';
import Tx from '../Tx.astro';
import { f } from './kit';

interface Row {
  kind: 'H' | 'P' | 'pad' | 'plug' | 'item' | 'node' | 'contact' | 'stick' | 'group' | 'text';
  label: string;
  k?: number;
  ks?: number[];
  color?: string;
}
interface Props {
  x: number;
  y: number;
  rows: Row[];
  /** Row height. */
  gap?: number;
  r?: number;
  /** Lay the rows out side by side instead, each `gap` wide. */
  across?: boolean;
}
const { x, y, rows, gap = 15, r = 3.6, across } = Astro.props;
const at = (i: number) => (across ? { x: x + i * gap, y } : { x, y: y + i * gap });
const sw = 14; // width of the sample
/** Width a row's sample takes: several item beads in a row are wider than one sample. */
const sampleW = (row: Row) =>
  row.kind === 'item' && row.ks ? 2 * r + (row.ks.length - 1) * r * 1.35 : row.kind === 'stick' ? sw + 3 : sw;
---

<g class="pmf-legend">
  {
    rows.map((row, i) => {
      const p = at(i);
      const cy = p.y - 3.6;
      return (
        <g>
          {row.kind === 'node' && <circle class="pmf-nodes-dot" cx={f(p.x + sw / 2)} cy={f(cy)} r={f(r * 0.32)} />}
          {row.kind === 'contact' && (
            <line class="pmf-contact" x1={p.x} x2={p.x + sw} y1={f(cy)} y2={f(cy)} stroke-width="1.4" stroke-dasharray="2 1.6" />
          )}
          {row.kind === 'stick' && (
            <>
              <line class="pmf-stick" x1={p.x + r} x2={p.x + sw - r + 4} y1={f(cy)} y2={f(cy)} stroke-width={f(r * 0.5)} />
              <Bead x={p.x + r} y={cy} r={r} kind="H" color={row.color} />
              <Bead x={p.x + sw - r + 4} y={cy} r={r} kind="H" color={row.color} />
            </>
          )}
          {row.kind === 'group' && (
            <rect class="pmf-ring-group" x={p.x} y={f(cy - r - 1)} width={sw} height={f(2 * r + 2)} rx={f(r + 1)} style={`stroke:${row.color ?? 'var(--fg-muted)'}`} />
          )}
          {row.kind === 'item' && row.ks ? (
            row.ks.map((k, j) => <Bead x={p.x + r + j * r * 1.35} y={cy} r={r} kind="item" k={k} />)
          ) : ['H', 'P', 'pad', 'plug', 'item'].includes(row.kind) ? (
            <Bead x={p.x + sw / 2} y={cy} r={r} kind={row.kind as 'H'} k={row.k} color={row.color} />
          ) : null}
          <Tx x={f(p.x + (row.kind === 'text' ? 0 : sampleW(row) + 6))} y={p.y} t={row.label} />
        </g>
      );
    })
  }
</g>
