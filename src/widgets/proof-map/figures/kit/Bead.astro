---
/**
 * One letter of the string as a lit bead: a disc in its colour with a darker rim and a highlight up and to the
 * left. P is hollow (pale fill, blue rim), as in the fold game. `dim` pushes it toward the
 * background, for context; `ghost` draws only a dashed outline (a node the chain will take).
 *
 *   <Bead x={10} y={20} r={4} kind="H" />   <Bead … kind="item" k={2} />
 */
import { beadColor, f, type Kind } from './kit';

interface Props {
  x: number;
  y: number;
  r?: number;
  kind?: Kind;
  k?: number;
  /** Any CSS colour, instead of the kind's. */
  color?: string;
  dim?: boolean;
  ghost?: boolean;
}
const { x, y, r = 4, kind = 'H', k = 0, color, dim, ghost } = Astro.props;
const c = color ?? beadColor(kind, k);
const hollow = kind === 'P';
---

<g
  class:list={['pmf-bead', hollow ? 'is-hollow' : 'is-solid', { 'is-dim': dim, 'is-ghost': ghost }]}
  style={`--c:${c}`}
  transform={`translate(${f(x)} ${f(y)})`}
>
  <circle r={r} stroke-width={f(hollow ? Math.max(1, r * 0.3) : Math.max(0.6, r * 0.16))} />
  {!hollow && !ghost && <circle class="pmf-hl" cx={f(-r * 0.32)} cy={f(-r * 0.34)} r={f(r * 0.36)} />}
</g>
