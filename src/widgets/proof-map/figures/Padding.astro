---
/**
 * Card "Filling the strips" (BL pp. 35–36). Every strip has T free nodes. Each takes a padding of
 * T − B nodes (drawn shortened, with a break), which leaves B. Strips 1 to K are the bins: the item
 * ribbons of bin i fill the B nodes of strip i, in snake order. The other strips take a plug of B.
 * Ribbons are drawn as dominoes (one per block PHHP), so each starts on an even node.
 */
import './fig.css';
import Tx from './Tx.astro';
import { N } from './notation';
import { itemColor, hbrace, hbreak } from './lib';
import { ITEMS, CAP, inBin, domino } from './story/items';

const x0 = 16;
const x1 = 304;
const pitch = 11;
const cell = 9.4;
const cellX = (u: number) => x1 - cell - (CAP - 1 - u) * pitch; // the B free nodes sit at the right end
const padEnd = cellX(0) - 5;
const brk = (x0 + padEnd) / 2;
const barY = [56, 104, 162];
type Seg = { k: number | null; plug?: boolean; n: number };
const rows: { label: string; segs: Seg[]; bin?: number }[] = [
  { label: `${N.strip} 1`, segs: inBin(0).map((k) => ({ k, n: ITEMS[k] })), bin: 0 },
  { label: `${N.strip} 2`, segs: inBin(1).map((k) => ({ k, n: ITEMS[k] })), bin: 1 },
  { label: `${N.strip}s ${N.K} + 1 to ${N.q}`, segs: [{ k: null, plug: true, n: CAP }] },
];
const blocks = (segs: Seg[]) => {
  let u = 0;
  return segs.flatMap((sg) => {
    const out = domino(sg.n).map((d) => ({ ...sg, u: u + d.x }));
    u += sg.n;
    return out;
  });
};
const last = barY[2];
---

<svg class="pmf" viewBox="0 0 320 206" role="img" aria-labelledby="pmf-pad-t">
  <title id="pmf-pad-t">Strips of T free nodes each, drawn as bars. Every strip takes a grey padding of T − B nodes, drawn shortened, which leaves B nodes at its end. Strips 1 to K are the bins: strip 1 takes the item ribbons of bin 1, u1 and u4, strip 2 those of bin 2, u2 and u3, and so on. Strips K + 1 to q take a plug of B nodes, in light grey. Every ribbon is made of blocks of two nodes.</title>
  <Tx x={x0} y="16" t={`each ${N.strip}: ${N.T} free nodes`} c="pmf-label-strong" />
  {
    rows.map((row, r) => {
      const y = barY[r];
      return (
        <g>
          <Tx x={x0} y={y - 13} t={row.label} c="pmf-label-strong" />
          {row.bin !== undefined ? (
            <text class="pmf-label" x={x1} y={y - 13} text-anchor="end">
              bin {row.bin + 1}:{' '}
              {inBin(row.bin).map((k, i) => (
                <>
                  {i > 0 && ', '}
                  <tspan class="pmf-v" font-weight="600" style={`fill:${itemColor(k)}`}>u</tspan>
                  <tspan font-weight="600" style={`fill:${itemColor(k)}`}>{N.item(k + 1).slice(1)}</tspan>
                </>
              ))}
            </text>
          ) : (
            <text class="pmf-label" x={x1} y={y - 13} text-anchor="end">{N.plug}</text>
          )}
          <rect class="pmf-bin" x={x0 - 4} y={y - 9} width={x1 - x0 + 8} height="18" rx="4" />
          <rect class="pmf-pad-bar" x={x0} y={y - cell / 2} width={brk - 5 - x0} height={cell} rx="2" />
          <rect class="pmf-pad-bar" x={brk + 5} y={y - cell / 2} width={padEnd - brk - 5} height={cell} rx="2" />
          <rect class="pmf-gap" x={brk - 5} y={y - 8} width="10" height="16" />
          <path class="pmf-break" d={hbreak(brk, y, 8)} />
          {blocks(row.segs).map((b) => (
            <rect
              class:list={[b.plug && 'pmf-pad-plug']}
              x={cellX(b.u)}
              y={y - cell / 2}
              width={pitch + cell}
              height={cell}
              rx="2"
              style={`fill:${b.k === null ? 'var(--pmf-pad)' : itemColor(b.k)}`}
            />
          ))}
        </g>
      );
    })
  }
  <text class="pmf-label" x={x0} y={(barY[1] + barY[2]) / 2 + 2}>⋮</text>
  <Tx x={x0 + 10} y={(barY[1] + barY[2]) / 2 + 2} t={`to ${N.strip} ${N.K}`} />
  <path class="pmf-brace" d={hbrace(x0, padEnd, last + 11, 1)} />
  <Tx x={(x0 + padEnd) / 2} y={last + 31} t={`${N.padding}: ${N.T} − ${N.B}`} a="middle" />
  <path class="pmf-brace" d={hbrace(cellX(0), cellX(CAP - 1) + cell, last + 11, 1)} />
  <Tx x={(cellX(0) + cellX(CAP - 1) + cell) / 2} y={last + 31} t={N.B} a="middle" />
</svg>

<style>
  .pmf-pad-bar {
    fill: var(--pmf-pad);
  }
  .pmf-pad-plug {
    opacity: 0.5;
  }
</style>
