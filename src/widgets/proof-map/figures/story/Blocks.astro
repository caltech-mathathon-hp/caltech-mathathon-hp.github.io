---
/**
 * Card "The counts match" (BL Facts 3.9–3.11, Figs. 1–2), drawn with the kit. A cube (drawn with
 * side 5) in oblique view on the cube's pale faces; every node of it holds an H, drawn faded but for
 * the string's pieces. A rod (PHP)^5 on the top right edge: each H has its two P's outside, one above
 * and one to the right, so it lies on an edge. A ribbon (PHHP)^3 on the front face: each H has one P
 * outside, in front of the face, so it lies on a face. In HPPH the two H's are neighbours: the
 * dashed gold contacts, between the blocks of the ribbon and along the rod.
 */
import '../fig.css';
import Tx from '../Tx.astro';
import Bead from '../kit/Bead.astro';
import Strand from '../kit/Strand.astro';
import Contact from '../kit/Contact.astro';
import { N } from '../notation';
import { oblique, pts, vbrace, type P3, type Pt } from '../lib';

const m = 4;
const U = 25;
const r = 6.2;
const pr = oblique(36, 176, U);
const face = (a: P3[]) => pts(a.map(pr));
type B = { p: P3; t: 'H' | 'P' };
// Rod on the edge x = m, y = m: each H has its two P's at (m+1, m, z) and (m, m+1, z).
const rod: B[] = [];
for (let z = 0; z <= m; z++) {
  const up: P3 = [m, m + 1, z];
  const right: P3 = [m + 1, m, z];
  const [a, b] = z % 2 === 0 ? [up, right] : [right, up];
  rod.push({ p: a, t: 'P' }, { p: [m, m, z], t: 'H' }, { p: b, t: 'P' });
}
const rodH = rod.filter((c) => c.t === 'H').map((c) => c.p);
// Ribbon on the front face z = 0: H pairs on the face, each P one step in front (z = −1).
const pairs: [number, number][][] = [
  [[1, 1], [2, 1]],
  [[2, 2], [1, 2]],
  [[1, 3], [2, 3]],
];
const rib: B[] = [];
for (const [[x1, y1], [x2, y2]] of pairs)
  rib.push({ p: [x1, y1, -1], t: 'P' }, { p: [x1, y1, 0], t: 'H' }, { p: [x2, y2, 0], t: 'H' }, { p: [x2, y2, -1], t: 'P' });
const ribBonds: [P3, P3][] = [
  [[2, 1, 0], [2, 2, 0]],
  [[1, 2, 0], [1, 3, 0]],
];
// The other H's on the three visible faces, faded; far ones first.
const key = (p: P3) => p.join(',');
const story = new Set([...rib, ...rod].filter((c) => c.t === 'H').map((c) => key(c.p)));
const rest: P3[] = [];
for (let z = m; z >= 0; z--)
  for (let y = 0; y <= m; y++)
    for (let x = 0; x <= m; x++) {
      const p: P3 = [x, y, z];
      if ((z === 0 || y === m || x === m) && !story.has(key(p))) rest.push(p);
    }
const byDepth = (a: B[]) => [...a].sort((u, v) => v.p[2] - u.p[2]);
const XY = (p: P3): Pt => pr(p);
const f0 = pr([0, 0, 0]);
const f1 = pr([0, m, 0]);
const ribP = XY(rib[0].p);
const rodTop = XY([m + 1, m, m]);
const lx = 228;
---

<svg class="pmf" viewBox="0 0 320 222" role="img" aria-labelledby="pmf-blocks-t">
  <title id="pmf-blocks-t">A cube whose nodes all hold H's, drawn faded except for two pieces of the string. A rod, PHP repeated five times, lies along its top right edge: each H has its two P's outside the cube, one above and one to the right, so it sits on an edge. A ribbon, PHHP repeated three times, lies on its front face: each H has one P outside, in front of the face, so it sits on a face. In each HPPH the two H's are neighbours, a contact drawn as a dashed line, along the rod and between the blocks of the ribbon.</title>
  <polygon class="pmf-slab" points={face([[0, 0, 0], [m, 0, 0], [m, m, 0], [0, m, 0]])} />
  <polygon class="pmf-slab pmf-slab-top" points={face([[0, m, 0], [m, m, 0], [m, m, m], [0, m, m]])} />
  <polygon class="pmf-slab pmf-slab-side" points={face([[m, 0, 0], [m, 0, m], [m, m, m], [m, m, 0]])} />
  {rest.map((p) => <Bead x={XY(p)[0]} y={XY(p)[1]} r={r} kind="H" dim />)}

  <!-- the rod -->
  <Strand pts={rod.map((c) => XY(c.p))} r={r} bare />
  {rodH.slice(1).map((p, i) => <Contact a={XY(rodH[i])} b={XY(p)} r={r} />)}
  {byDepth(rod).map((c) => <Bead x={XY(c.p)[0]} y={XY(c.p)[1]} r={r} kind={c.t} />)}

  <!-- the ribbon -->
  <Strand pts={rib.map((c) => XY(c.p))} r={r} bare />
  {ribBonds.map(([a, b]) => <Contact a={XY(a)} b={XY(b)} r={r} />)}
  {rib.map((c) => <Bead x={XY(c.p)[0]} y={XY(c.p)[1]} r={r} kind={c.t} />)}

  <path class="pmf-brace" d={vbrace(f0[0] - 12, f1[1], f0[1], -1)} />
  <Tx x={f0[0] - 24} y={(f0[1] + f1[1]) / 2 + 4} t={N.n} a="middle" />

  <polyline class="pmf-lead" points={pts([[rodTop[0] + r + 3, rodTop[1] - 2], [lx - 4, 34]])} />
  <text class="pmf-label-strong" x={lx} y="30">rod</text>
  <text class="pmf-label" x={lx} y="45">two P's outside,</text>
  <text class="pmf-label" x={lx} y="59">so on an edge</text>

  <polyline class="pmf-lead" points={pts([[ribP[0], ribP[1] + r + 3], [ribP[0], 196]])} />
  <text class="pmf-label-strong" x={ribP[0] - 4} y="210">ribbon</text>
  <text class="pmf-label" x={ribP[0] + 38} y="210">one P outside, so on a face</text>

  <line class="pmf-contact" x1={lx} y1="116" x2={lx + 16} y2="116" stroke-width="2" stroke-dasharray="3 2.4" />
  <text class="pmf-label" x={lx + 22} y="120">HPPH:</text>
  <text class="pmf-label" x={lx + 22} y="134">neighbours</text>
</svg>
