---
/**
 * Cards "Walls run straight" (bl-walls) and "Reading off a packing" (bl-packing, `filled`): the front
 * face, shortened (story/face.ts), drawn like the explainer video (still v22). Rods are lone H's on
 * the two free edges, walls are pairs of H's joined by a stick, the cube's edges above and below are
 * faded.
 * Empty: long rods on the left free edge, short rods and the spaced rod (ringed in blue) on the
 * right; each period lays two straight walls of n − 2 H's, and the walls cut the face into q strips.
 * `filled`: the running example of story/items.ts. Three periods are drawn, strips 1, 2 and q, and
 * the frame is faded. Every strip holds a grey padding ribbon and leaves a hole of B = CAP nodes at
 * the end of its last row: the items fill the holes of strips 1 and 2 (6 + 4 and 2 + 8), a plug
 * fills the hole of strip q.
 */
import '../fig.css';
import Tx from '../Tx.astro';
import Bead from '../kit/Bead.astro';
import Strand from '../kit/Strand.astro';
import Nodes from '../kit/Nodes.astro';
import Ring from '../kit/Ring.astro';
import Legend from '../kit/Legend.astro';
import { N } from '../notation';
import { itemColor, hbrace, vbrace, hbreak, vbreak } from '../lib';
import { faceGeom, pairs } from './face';
import { ITEMS, CAP, inBin } from './items';

interface Props {
  filled?: boolean;
}
const { filled = false } = Astro.props;
const uid = filled ? 'pmf-packing' : 'pmf-walls';

/* Filled: one more period (strips 1, 2 | q) and a strip row long enough for a hole of B nodes. */
const F = filled
  ? faceGeom({ ox: 40, oy: 14, s: 11, gx: 12, gy: 12, inner: CAP + 2, split: 2, periods: 3, breaks: [1] })
  : faceGeom({ ox: 66, oy: 36, s: 12, gx: 14, gy: 12 });
const { X, Y, right, box } = F;
const r = filled ? 3.5 : 3.7;
const P = Array.from({ length: F.periods }, (_, p) => p);
const periods = P.map((p) => F.period(p));
const rods = periods.flatMap((q) => [...q.qRod1, ...q.q2Rod, ...q.qRod2]);
const walls = periods.flatMap((q) => [...pairs(q.wall1), ...pairs(q.wall2)]);
const spaced = periods.map((q) => q.spaced);
const foot = box.y + box.h;
const snakes = P.map((p) => F.stripSnake(p));

/* Filled: the padding of each strip, then in its hole the items of one bin, or a plug (last strip). */
const holes = snakes.map((sn) => sn.slice(sn.length - CAP));
const padPairs = snakes.flatMap((sn) => pairs(sn.slice(0, sn.length - CAP)));
const bins = [0, 1].map((b) => {
  let at = 0;
  return inBin(b).map((k) => {
    const cells = holes[b].slice(at, at + ITEMS[k]);
    at += ITEMS[k];
    return { k, cells };
  });
});
const plugPairs = pairs(holes[F.periods - 1]);

const mid = (p: number) => Y(F.top(p) + 2) + 4;
const holeY = (p: number) => Y(F.top(p) + 3);
const lx = box.x + box.w + 30; // right-hand labels (empty face)
const rx = box.x + box.w + 8; // right-hand labels (filled face)
const breaks = [box.y, foot, ...P.flatMap((p) => [F.top(p), F.bot(p)]).map(Y)];
const H = filled ? Math.ceil(foot + 30) : 218;
---

<svg class="pmf" viewBox={`0 0 320 ${H}`} role="img" aria-labelledby={`${uid}-t`}>
  <title id={`${uid}-t`}>
    {
      filled
        ? 'The front face, shortened, with the walls and rods faded and the strips filled; three strips are drawn: strip 1, strip 2 and the last, strip q. Every strip holds a grey padding ribbon, in pairs of H\'s, which leaves a hole of B nodes at the end of the strip. In strip 1 the ribbons of the items 6 and 4 fill the hole, each ringed in its colour: bin 1 = 6 + 4. In strip 2 the items 2 and 8 fill it: bin 2 = 2 + 8. In strip q a light grey plug fills the hole, so that strip is not a bin. Each ribbon stays inside one strip.'
        : 'The front face of the cube, shortened by break marks, between the faded cube edges at its top and bottom. Long rods of lone H\'s fill its left free edge, 2q + 1 rows each; short rods of q H\'s fill its right free edge, with an H of the spaced rod, ringed in blue, between two of them. Each period lays two straight walls of n − 2 H\'s across the face, in pairs, and between two walls lies an empty strip: strip 1, and so on to strip q.'
    }
  </title>
  <rect class="pmf-slab" x={box.x} y={box.y} width={box.w} height={box.h} rx="4" />
  {F.edgeNodes.map(([x, y]) => <Bead x={x} y={y} r={r} dim />)}

  {
    !filled && (
      <g>
        {P.map((p) => {
          const b = F.stripBox(p, 1.5);
          return <rect class="pmf-ff-strip" x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />;
        })}
        {snakes.map((sn) => <Nodes pts={sn} r={r} />)}
      </g>
    )
  }

  <g class:list={[{ 'is-dim': filled }]}>
    {walls.map((w) => <Strand pts={w} r={r} />)}
    {rods.map(([x, y]) => <Bead x={x} y={y} r={r} />)}
    {spaced.map(([x, y]) => <Bead x={x} y={y} r={r} />)}
  </g>
  {!filled && spaced.map(([x, y]) => <circle class="pmf-ff-spaced" cx={x} cy={y} r={r + 2.4} />)}

  {
    filled && (
      <g>
        {padPairs.map((w) => <Strand pts={w} r={r} kinds={['pad']} />)}
        {plugPairs.map((w) => <Strand pts={w} r={r} kinds={['plug']} />)}
        {bins.flat().map((it) => (
          <>
            <Ring x1={it.cells[0][0]} y1={it.cells[0][1]} x2={it.cells.at(-1)![0]} y2={it.cells.at(-1)![1]} r={r} pad={1.4} color={itemColor(it.k)} />
            {pairs(it.cells).map((w) => <Strand pts={w} r={r} item k={it.k} />)}
          </>
        ))}
      </g>
    )
  }

  <!-- breaks: the columns and the periods left out -->
  {breaks.map((y) => <path class="pmf-break" d={hbreak(F.colBreak, y, 5)} />)}
  {F.cuts.flatMap((p) => [box.x, box.x + box.w].map((x) => <path class="pmf-break" d={vbreak(x, F.rowBreak(p), 5)} />))}

  {
    !filled && (
      <g>
        <Tx x={box.x - 2} y={box.y - 8} t={`${N.q2Rod}s`} />
        <Tx x={box.x + box.w + 2} y={box.y - 8} t={`${N.qRod}s`} a="end" />
        <path class="pmf-brace" d={vbrace(box.x - 4, Y(F.top(0)) - 4, Y(F.bot(0)) + 4, -1)} />
        <Tx x={box.x - 14} y={mid(0)} t={`2${N.q} + 1`} a="end" />
        <path class="pmf-brace" d={vbrace(box.x + box.w + 4, Y(F.top(0)) - 4, Y(F.top(0) + 1) + 4, 1)} />
        <Tx x={box.x + box.w + 14} y={Y(F.top(0) + 0.5) + 4} t={N.q} />
        <path class="pmf-brace" d={hbrace(X(1) - 3, X(F.inner) + 3, foot + 4, 1)} />
        <Tx x={(X(1) + X(F.inner)) / 2} y={foot + 24} t={`${N.n} − 2`} a="middle" />
        <text class="pmf-label-sm" x={lx} y={Y(0) + 3.5}>cube edge</text>
        {[F.top(0), F.bot(0)].map((row) => <text class="pmf-label" x={lx} y={Y(row) + 4}>wall</text>)}
        <Tx x={lx} y={mid(0)} t={`${N.strip} 1`} c="pmf-label-strong" />
        <Tx x={lx} y={mid(1)} t={`${N.strip} ${N.q}`} c="pmf-label-strong" />
        <Bead x={lx + 4} y={foot + 16} r={r} />
        <circle class="pmf-ff-spaced" cx={lx + 4} cy={foot + 16} r={r + 2.4} />
        <text class="pmf-label" x={lx + 14} y={foot + 20}>{N.spaced}</text>
      </g>
    )
  }
  {
    filled && (
      <g>
        {P.map((p) => (
          <>
            <Tx x={rx + 4} y={holeY(p) - 10} t={`${N.strip} ${p === F.periods - 1 ? N.q : p + 1}`} c="pmf-label-sm" />
            <path class="pmf-lead" d={`M${box.x + box.w + 2} ${holeY(p)}H${rx}`} />
          </>
        ))}
        {bins.map((bin, b) => (
          <text class="pmf-label-strong" x={rx + 4} y={holeY(b) + 4}>
            bin {b + 1} ={' '}
            {bin.map((it, i) => (
              <>
                {i > 0 && ' + '}
                <tspan style={`fill:${itemColor(it.k)}`}>{ITEMS[it.k]}</tspan>
              </>
            ))}
          </text>
        ))}
        <text class="pmf-label" x={rx + 4} y={holeY(F.periods - 1) + 4}>{N.plug}</text>
        <Legend
          x={box.x + 2}
          y={foot + 22}
          r={r}
          gap={84}
          across
          rows={[
            { kind: 'pad', label: N.padding },
            { kind: 'plug', label: N.plug },
          ]}
        />
        <g class="is-dim">
          <Bead x={box.x + 2 + 168 + 7} y={foot + 18.4} r={r} />
        </g>
        <text class="pmf-label" x={box.x + 2 + 168 + 20} y={foot + 22}>walls and rods</text>
      </g>
    )
  }
</svg>

<style>
  .pmf-ff-strip {
    fill: var(--bg-elev);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .pmf-ff-spaced {
    fill: none;
    stroke: var(--p);
    stroke-width: 1.3;
  }
</style>
