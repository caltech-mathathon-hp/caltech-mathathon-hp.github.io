---
/**
 * Card "Why bin packing" (BL §2, MODIFIED BIN PACKING), drawn with the kit like the bin packing
 * game. Left: the items of the running example (story/items.ts), each a bar of its size with a chip
 * naming it by that size. Right: the K empty bins of size B, a lattice dot in every unit. Below: an
 * item becomes as many H's as its size, two at a time as in a ribbon.
 */
import '../fig.css';
import Tx from '../Tx.astro';
import Item from '../kit/Item.astro';
import Bin from '../kit/Bin.astro';
import Strand from '../kit/Strand.astro';
import { N } from '../notation';
import { hbrace, type Pt } from '../lib';
import { ITEMS, CAP } from './items';

const u = 10; // one unit: one node, one H
const h = 14;
const ix = 16;
const itemY = (k: number) => 48 + k * 22;
const bx = 202;
const binY = [64, 96];
const binW = CAP * u;

/* An item becomes |item| H's: the first item, its H's in pairs as in a ribbon (PHHP)^(size/2). */
const k0 = 0;
const size0 = ITEMS[k0];
const sy = 188;
const sx = 136;
const r = 4.4;
const pairs: Pt[][] = Array.from({ length: size0 / 2 }, (_, i) => [
  [sx + i * 34, sy],
  [sx + i * 34 + 14, sy],
]);
const sEnd = pairs.at(-1)![1][0];
---

<svg class="pmf" viewBox="0 0 320 206" role="img" aria-labelledby="pmf-instance-t">
  <title id="pmf-instance-t">Bin packing as in the game. On the left, the items of sizes {ITEMS.join(', ')}, each a bar as long as its size. On the right, K empty bins, each with room for B units. The sizes are even and add up to K times B. Below, the item of size {size0} becomes {size0} H's of the string, two at a time.</title>

  <text class="pmf-label-strong" x={ix} y="22">items</text>
  {ITEMS.map((size, k) => <Item x={ix} y={itemY(k)} units={size} u={u} h={h} k={k} chip={String(size)} />)}

  <Tx x={bx - 2} y="22" t={`${N.K} bins of size ${N.B}`} c="pmf-label-strong" />
  <path class="pmf-brace" d={hbrace(bx, bx + binW, binY[0] - 13, -1)} />
  <Tx x={bx + binW / 2} y={binY[0] - 23} t={N.B} a="middle" />
  {
    binY.map((y, b) => (
      <g>
        <Bin x={bx} y={y} units={CAP} u={u} h={h} />
        <Tx x={bx - 9} y={y + 4} t={`bin ${b + 1}`} a="end" c="pmf-label-sm" />
      </g>
    ))
  }
  <Tx x={bx + binW / 2} y={binY[1] + 28} t={`here ${N.K} = ${binY.length} and ${N.B} = ${CAP}`} a="middle" c="pmf-label-sm" />

  <Tx x={ix} y="154" t={`sizes even, adding up to ${N.K} · ${N.B}`} />

  <Item x={ix} y={sy} units={size0} u={u} h={h} k={k0} chip={String(size0)} />
  <line class="pmf-lead" x1={ix + size0 * u + 8} y1={sy} x2={sx - 13} y2={sy} marker-end="url(#pmf-instance-arrow)" />
  <text class="pmf-label-sm" x={(ix + size0 * u + sx - 5) / 2} y={sy - 8} text-anchor="middle">in the string</text>
  {pairs.map((p) => <Strand pts={p} kinds="H" item k={k0} r={r} />)}
  <text class="pmf-label" x={sEnd + 10} y={sy + 4}>{size0} H's</text>
  <defs>
    <marker id="pmf-instance-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0L8 4L0 8z" class="pmf-instance-head" />
    </marker>
  </defs>
</svg>

<style>
  .pmf-instance-head {
    fill: var(--fg-muted);
  }
</style>
