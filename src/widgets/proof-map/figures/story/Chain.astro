---
/**
 * Card "Spelling the string" (BL Fig. 3), drawn with the kit: the string, shortened by break marks,
 * in its three parts, one letter per bead (H lit, P hollow).
 * Frame: rods PHP, face ribbons PHHP, the core of H's. Walls: one period (short rod, wall, long rod,
 * wall, short rod) standing for q, then the spaced rod, whose runs of P's are drawn as loops.
 * Item part: a padding and a plug standing for the q paddings and q − K plugs (their H's grey and
 * light grey), then one item ribbon per item of the running example (story/items.ts), in its colour,
 * ringed and named by its size. Each ribbon of the item part comes after a linker, a long run of
 * P's drawn as a loop.
 */
import '../fig.css';
import Tx from '../Tx.astro';
import Bead from '../kit/Bead.astro';
import Strand from '../kit/Strand.astro';
import Ring from '../kit/Ring.astro';
import { N } from '../notation';
import { hbreak, hbrace, type Pt } from '../lib';
import type { Kind } from '../kit/kit';
import { ITEMS } from './items';

const p = 10; // one letter
const r = 3.2;
const x0 = 16;
type B = { x: number; y: number; kind: Kind; k?: number };
type Piece = { beads: B[]; label?: string; k?: number; ring?: boolean };

/** A run of letters "PHHP…" from x along row y; H's drawn as `h` (item k, padding, plug). */
const run = (s: string, x: number, y: number, h: Kind = 'H', k?: number): B[] =>
  [...s].map((t, i) => ({ x: x + i * p, y, kind: t === 'P' ? 'P' : h, k }));
/** A run of P's hanging below the row as a loop, starting at x (a linker, or the spaced rod's P's). */
const loop = (x: number, y: number): B[] => [
  { x, y, kind: 'P' },
  { x, y: y + p, kind: 'P' },
  { x: x + p, y: y + p, kind: 'P' },
  { x: x + p, y, kind: 'P' },
];
const lastX = (a: B[]) => a[a.length - 1].x;
/** Break: the stick runs on from x1 to x2, with a gap and a break mark in the middle. */
const brk = (x1: number, x2: number, y: number) => ({ x1, x2, y, m: (x1 + x2) / 2 });

/* ---------- frame ---------- */
const yA = 36;
const rods = run('PHPPHP', x0, yA);
const ribs = run('PHHPPHHP', lastX(rods) + 26, yA);
const core = run('PHHHH', lastX(ribs) + 26, yA);
const frame: Piece[] = [
  { beads: rods, label: 'rods' },
  { beads: ribs, label: 'face ribbons' },
  { beads: core, label: 'core' },
];
const frameBreaks = [brk(lastX(rods), ribs[0].x, yA), brk(lastX(ribs), core[0].x, yA), brk(lastX(core), lastX(core) + 24, yA)];

/* ---------- walls ---------- */
const yB = 100;
const periodSpec = [
  ['PHP', 'short rod'],
  ['PHHP', 'wall'],
  ['PHP', 'long rod'],
  ['PHHP', 'wall'],
  ['PHP', 'short rod'],
];
let px = x0;
const period: Piece[] = periodSpec.map(([s, label]) => {
  const beads = run(s, px, yB);
  px = lastX(beads) + 17;
  return { beads, label };
});
const pEnd = lastX(period.at(-1)!.beads);
const periodBreaks = period.slice(1).map((g, i) => brk(lastX(period[i].beads), g.beads[0].x, yB));
const sx = pEnd + 26;
const spacedHs = [sx + p, sx + 4 * p, sx + 7 * p];
const spaced: B[] = [
  { x: sx, y: yB, kind: 'P' },
  { x: spacedHs[0], y: yB, kind: 'H' },
  ...loop(spacedHs[0] + p, yB),
  { x: spacedHs[1], y: yB, kind: 'H' },
  ...loop(spacedHs[1] + p, yB),
  { x: spacedHs[2], y: yB, kind: 'H' },
  { x: spacedHs[2] + p, y: yB, kind: 'P' },
];
const toSpaced = brk(pEnd, sx, yB);

/* ---------- item part ---------- */
type Spec = { s: string; h: Kind; k?: number; label: string; ring?: boolean; cut?: number; tail?: boolean };
/**
 * A row of the item part: each ribbon after a linker loop. `cut` breaks a ribbon after that many
 * letters (it is much longer), `tail` breaks the run after it (more ribbons of the kind follow).
 * Returns the beads, the runs the stick goes through, and where the break marks go.
 */
const itemRow = (y: number, specs: Spec[], last = false) => {
  let x = x0;
  const pieces: (Piece & { label: string })[] = [];
  const links: B[][] = [];
  const marks: number[] = [];
  const runs: Pt[][] = [];
  let cur: Pt[] = [[x - 9, y]];
  const breakAt = (x1: number) => {
    const m = x1 + 11;
    cur.push([m - 4, y]);
    runs.push(cur);
    cur = [[m + 4, y]];
    marks.push(m);
    return x1 + 22;
  };
  for (const sp of specs) {
    const l = loop(x, y);
    links.push(l);
    cur.push(...l.map((b) => [b.x, b.y] as Pt));
    x += 2 * p;
    const parts = sp.cut ? [sp.s.slice(0, sp.cut), sp.s.slice(sp.cut)] : [sp.s];
    const beads: B[] = [];
    parts.forEach((part, i) => {
      const bs = run(part, x, y, sp.h, sp.k);
      beads.push(...bs);
      cur.push(...bs.map((b) => [b.x, b.y] as Pt));
      x = lastX(bs);
      x = i < parts.length - 1 ? breakAt(x) : x + p;
    });
    pieces.push({ beads, label: sp.label, k: sp.k, ring: sp.ring });
    if (sp.tail) x = breakAt(x - p) ;
  }
  if (!last) cur.push([x - p + 9, y]);
  runs.push(cur);
  return { y, pieces, links, marks, runs: runs.filter((c) => c.length > 1) };
};
const yC = 194;
const padRow = itemRow(yC, [
  { s: 'PHHPPHHPPHHP', h: 'pad', label: `${N.q} paddings`, cut: 8, tail: true },
  { s: 'PHHPPHHP', h: 'plug', label: `${N.q} − ${N.K} plugs`, tail: true },
]);
const ribbon = (size: number) => 'PHHP'.repeat(size / 2);
const order: Spec[] = ITEMS.map((size, k) => ({ s: ribbon(size), h: 'item', k, label: String(size), ring: true }));
const yD = 240;
const yE = 284;
const rows = [padRow, itemRow(yD, order.slice(0, 2)), itemRow(yE, order.slice(2), true)];
const linkerAt = padRow.links[0];
const itemC = (k: number) => `var(--pmf-i${(k % 4) + 1})`;
---

<svg class="pmf" viewBox="0 0 320 300" role="img" aria-labelledby="pmf-string-t">
  <title id="pmf-string-t">The string, shortened, one bead per letter, in three parts. The frame: rods PHP, face ribbons PHHP and the core, a run of H's. The walls: one period, made of a short rod, a wall, a long rod, a wall and a short rod, stands for q periods; then the spaced rod, whose H's are far apart, with long runs of P's between them. The item part: a padding with grey H's stands for the q paddings, a plug with light grey H's for the q − K plugs, then one ribbon per item, of {ITEMS.join(', ')} H's in the item colours. Each ribbon of the item part comes after a linker, a long run of P's drawn as a loop.</title>

  <!-- frame -->
  <text class="pmf-label-strong" x={x0} y="16">frame</text>
  {
    frameBreaks.map((b) => (
      <g>
        <Strand pts={[[b.x1, yA], [b.m - 4, yA]]} bare r={r} />
        <Strand pts={[[b.m + 4, yA], [b.x2, yA]]} bare r={r} />
        <path class="pmf-break" d={hbreak(b.m, yA, 5)} />
      </g>
    ))
  }
  {
    frame.map((g) => (
      <g>
        <Strand pts={g.beads.map((b) => [b.x, b.y] as Pt)} kinds={g.beads.map((b) => b.kind)} r={r} />
        <Tx x={(g.beads[0].x + lastX(g.beads)) / 2} y={yA + 18} t={g.label!} a="middle" />
      </g>
    ))
  }

  <!-- walls -->
  <text class="pmf-label-strong" x={x0} y="80">walls</text>
  {
    [...periodBreaks, toSpaced].map((b) => (
      <g>
        <Strand pts={[[b.x1, yB], [b.m - 4, yB]]} bare r={r} />
        <Strand pts={[[b.m + 4, yB], [b.x2, yB]]} bare r={r} />
        <path class="pmf-break" d={hbreak(b.m, yB, 5)} />
      </g>
    ))
  }
  {
    period.map((g) => (
      <g>
        <Strand pts={g.beads.map((b) => [b.x, b.y] as Pt)} kinds={g.beads.map((b) => b.kind)} r={r} />
        <Tx x={(g.beads[0].x + lastX(g.beads)) / 2} y={yB + 16} t={g.label!} a="middle" c="pmf-label-sm" />
      </g>
    ))
  }
  <path class="pmf-brace" d={hbrace(period[0].beads[0].x - 3, pEnd + 3, yB + 22, 1)} />
  <Tx x={(period[0].beads[0].x + pEnd) / 2} y={yB + 42} t={`${N.q} periods`} a="middle" />
  <Strand pts={spaced.map((b) => [b.x, b.y] as Pt)} kinds={spaced.map((b) => b.kind)} r={r} />
  <Tx x={(sx + spacedHs[2] + p) / 2} y={yB + 42} t={N.spaced} a="middle" />

  <!-- item part -->
  <text class="pmf-label-strong" x={x0} y="162">item part</text>
  {
    rows.map((row) => (
      <g>
        {row.runs.map((c) => <Strand pts={c} bare r={r} />)}
        {row.marks.map((m) => <path class="pmf-break" d={hbreak(m, row.y, 5)} />)}
        {row.links.map((l) => l.map((b) => <Bead x={b.x} y={b.y} r={r} kind="P" />))}
        {row.pieces.map((pc) => (
          <g>
            {pc.ring && <Ring x1={pc.beads[0].x} y1={row.y} x2={lastX(pc.beads)} r={r} color={itemC(pc.k!)} />}
            {pc.beads.map((b) => <Bead x={b.x} y={b.y} r={r} kind={b.kind} k={b.k} />)}
            {pc.ring ? (
              <text class="pmf-label-strong" x={(pc.beads[0].x + lastX(pc.beads)) / 2} y={row.y - 11} text-anchor="middle" style={`fill:${itemC(pc.k!)}`}>
                {pc.label}
              </text>
            ) : (
              <Tx x={(pc.beads[0].x + lastX(pc.beads)) / 2} y={row.y - 10} t={pc.label} a="middle" />
            )}
          </g>
        ))}
      </g>
    ))
  }
  <text class="pmf-label-sm" x={linkerAt[0].x + p / 2} y={yC + p + 16} text-anchor="middle">{N.linker}</text>
</svg>
