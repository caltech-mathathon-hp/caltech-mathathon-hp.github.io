---
/**
 * Card "The skeleton" (BL §3.2.2, Figs. 4–5): the 12 edges of the cube, 12n − 16 nodes, drawn for
 * n = 6. The corner rod (PHP)^(9n−10) fills nine edges: around the top face, down the back right
 * edge, around the bottom face (all eight corners). The tenth-edge rod fills the back left edge.
 * The two free edges of the front face stay empty (hollow) until the walls.
 * Edges hidden behind the cube are dashed and their H's faded.
 */
import './fig.css';
import Tx from './Tx.astro';
import { N } from './notation';
import { oblique, pts, hbrace, type P3 } from './lib';

const m = 5; // n − 1 steps per edge
const U = 100;
const pr = oblique(22, 178, U / m);
const face = (a: P3[]) => pts(a.map(pr));
const run = (a: P3, b: P3): P3[] => {
  const d = b.map((v, i) => Math.sign(v - a[i])) as P3;
  const len = Math.max(...b.map((v, i) => Math.abs(v - a[i])));
  return Array.from({ length: len + 1 }, (_, t) => a.map((v, i) => v + d[i] * t) as P3);
};
const join = (...segs: P3[][]) => segs.flatMap((s, i) => (i === 0 ? s : s.slice(1)));
const T = m; // top
const K = m; // back
/* Corner rod: from (n−2, top, back) round the top face, down the back right edge, round the bottom face. */
const corner = join(
  run([m - 1, T, K], [0, T, K]),
  run([0, T, K], [0, T, 0]),
  run([0, T, 0], [m, T, 0]),
  run([m, T, 0], [m, T, K]),
  run([m, T, K], [m, 0, K]),
  run([m, 0, K], [m, 0, 0]),
  run([m, 0, 0], [0, 0, 0]),
  run([0, 0, 0], [0, 0, K]),
  run([0, 0, K], [m - 1, 0, K]),
);
const tenth = run([0, 1, K], [0, m - 1, K]);
const freeL = run([0, 1, 0], [0, m - 1, 0]);
const freeR = run([m, 1, 0], [m, m - 1, 0]);
/* Hidden: nodes on the back left, bottom left and bottom back edges, but for visible corners. */
const hidden = (p: P3) => (p[0] === 0 && p[2] === K && p[1] < T) || (p[1] === 0 && p[0] === 0 && p[2] > 0) || (p[1] === 0 && p[2] === K && p[0] < m);
/* Split the corner rod into visible and hidden stretches. */
const stretches: { h: boolean; a: P3[] }[] = [];
for (let i = 1; i < corner.length; i++) {
  const h = hidden(corner[i]) || hidden(corner[i - 1]);
  const last = stretches.at(-1);
  if (last && last.h === h) last.a.push(corner[i]);
  else stretches.push({ h, a: [corner[i - 1], corner[i]] });
}
const hiddenEdges: [P3, P3][] = [
  [[0, 0, 0], [0, 0, K]],
  [[0, 0, K], [m, 0, K]],
  [[0, 0, K], [0, T, K]],
];
const f0 = pr([0, 0, 0]);
const f1 = pr([m, 0, 0]);
const [tx, ty] = pr([0, m - 1, K]);
const [cx, cy] = pr([2, T, K]);
const fy = (pr([0, 1, 0])[1] + pr([0, 2, 0])[1]) / 2 + 4;
const fl = pr([0, 0, 0])[0];
const fr = pr([m, 0, 0])[0];
const lx = 200;
---

<svg class="pmf" viewBox="0 0 320 206" role="img" aria-labelledby="pmf-skel-t">
  <title id="pmf-skel-t">The cube with only its twelve edges filled in: 12n − 16 nodes on edges and corners, one H each. The corner rod fills nine edges: around the top face, down the back right edge, and around the bottom face, through all eight corners. The tenth-edge rod fills the back left edge. The two free edges of the front face, on its left and right, stay empty for the walls. Edges hidden behind the cube are dashed.</title>
  {hiddenEdges.map(([a, b]) => <polyline class="pmf-edge-line" stroke-dasharray="3 3" points={face([a, b])} />)}
  <polygon class="pmf-face pmf-sk-glass" points={face([[0, T, 0], [m, T, 0], [m, T, K], [0, T, K]])} />
  <polygon class="pmf-face pmf-sk-glass" points={face([[m, 0, 0], [m, 0, K], [m, T, K], [m, T, 0]])} />
  <polygon class="pmf-face pmf-face-front pmf-sk-glass" points={face([[0, 0, 0], [m, 0, 0], [m, T, 0], [0, T, 0]])} />

  <!-- tenth-edge rod, behind -->
  <g class="pmf-sk-behind">
    <polyline class="pmf-chain" stroke-dasharray="3 3" points={face(tenth)} />
    {tenth.map((p) => <circle class="pmf-h" cx={pr(p)[0]} cy={pr(p)[1]} r="3.6" />)}
  </g>
  <!-- corner rod -->
  {stretches.map((s) => <polyline class:list={['pmf-chain', s.h && 'pmf-sk-behind']} stroke-dasharray={s.h ? '3 3' : undefined} points={face(s.a)} />)}
  {corner.map((p) => <circle class:list={['pmf-h', hidden(p) && 'pmf-sk-behind']} cx={pr(p)[0]} cy={pr(p)[1]} r="3.6" />)}
  <!-- free edges -->
  {[...freeL, ...freeR].map((p) => <circle class="pmf-sk-free" cx={pr(p)[0]} cy={pr(p)[1]} r="3.4" />)}

  <text class="pmf-label pmf-halo" x={(fl + fr) / 2} y={fy} text-anchor="middle">free edges</text>
  <path class="pmf-lead" d={`M${(fl + fr) / 2 - 31} ${fy - 4}L${fl + 7} ${fy - 4}M${fl + 11} ${fy - 7}L${fl + 7} ${fy - 4}L${fl + 11} ${fy - 1}`} />
  <path class="pmf-lead" d={`M${(fl + fr) / 2 + 31} ${fy - 4}L${fr - 7} ${fy - 4}M${fr - 11} ${fy - 7}L${fr - 7} ${fy - 4}L${fr - 11} ${fy - 1}`} />
  <text class="pmf-label" x="2" y="14">{N.tenth}</text>
  <path class="pmf-lead" d={`M40 19L${tx - 4} ${ty - 3}`} />
  <text class="pmf-label" x={cx + 6} y="14">{N.corner}</text>
  <path class="pmf-lead" d={`M${cx + 14} 18L${cx + 2} ${cy - 5}`} />
  <path class="pmf-brace" d={hbrace(f0[0], f1[0], f0[1] + 6, 1)} />
  <Tx x={(f0[0] + f1[0]) / 2} y={f0[1] + 26} t={N.n} a="middle" />

  <Tx x={lx} y="44" t="edges and corners:" c="pmf-label-strong" />
  <Tx x={lx} y="58" t={`12${N.n} − 16 nodes,`} />
  <text class="pmf-label" x={lx} y="72">one H each</text>
  <text class="pmf-label" x={lx} y="102">{N.corner}: 9 edges</text>
  <text class="pmf-label" x={lx} y="118">{N.tenth}: 1</text>
  <text class="pmf-label" x={lx} y="134">free edges: 2,</text>
  <text class="pmf-label" x={lx} y="148">left for the walls</text>
</svg>

<style>
  .pmf-sk-glass {
    fill-opacity: 0.45;
  }
  .pmf-sk-behind {
    opacity: 0.5;
  }
  .pmf-sk-free {
    fill: var(--bg-elev);
    stroke: var(--h);
    stroke-width: 1.3;
  }
</style>
