---
/**
 * Card "Two edges stay free" (BL §3.2.2, Figs. 4–5): the 12 edges of the cube, 12n − 16 nodes, drawn
 * for n = 6 in the look of the explainer video (still 15). The corner rod (PHP)^(9n−10) fills nine
 * edges: around the top face, down the back right edge, around the bottom face (all eight corners).
 * The tenth-edge rod fills the back left edge (ringed). The two free edges of the front face stay
 * empty until the walls: blue slots with empty nodes. Rods are lone H's (P's between them), so no
 * sticks. The faces are pale glass: what lies behind them shows through, faded.
 */
import './fig.css';
import Tx from './Tx.astro';
import Bead from './kit/Bead.astro';
import Nodes from './kit/Nodes.astro';
import Ring from './kit/Ring.astro';
import { N } from './notation';
import { oblique, pts, hbrace, type P3, type Pt } from './lib';

const m = 5; // n − 1 steps per edge
const U = 100;
const pr = oblique(22, 178, U / m);
const face = (a: P3[]) => pts(a.map(pr));
const r = 4;
const run = (a: P3, b: P3): P3[] => {
  const d = b.map((v, i) => Math.sign(v - a[i])) as P3;
  const len = Math.max(...b.map((v, i) => Math.abs(v - a[i])));
  return Array.from({ length: len + 1 }, (_, t) => a.map((v, i) => v + d[i] * t) as P3);
};
const join = (...segs: P3[][]) => segs.flatMap((s, i) => (i === 0 ? s : s.slice(1)));
const T = m; // top
const K = m; // back
/* Corner rod: from (n−2, top, back) round the top face, down the back right edge, round the bottom face. */
const corner = join(
  run([m - 1, T, K], [0, T, K]),
  run([0, T, K], [0, T, 0]),
  run([0, T, 0], [m, T, 0]),
  run([m, T, 0], [m, T, K]),
  run([m, T, K], [m, 0, K]),
  run([m, 0, K], [m, 0, 0]),
  run([m, 0, 0], [0, 0, 0]),
  run([0, 0, 0], [0, 0, K]),
  run([0, 0, K], [m - 1, 0, K]),
);
const tenth = run([0, 1, K], [0, m - 1, K]);
const freeL = run([0, 1, 0], [0, m - 1, 0]);
const freeR = run([m, 1, 0], [m, m - 1, 0]);
/* Hidden: nodes on the back left, bottom left and bottom back edges, but for visible corners. */
const hidden = (p: P3) => (p[0] === 0 && p[2] === K && p[1] < T) || (p[1] === 0 && p[0] === 0 && p[2] > 0) || (p[1] === 0 && p[2] === K && p[0] < m);
const hiddenEdges: [P3, P3][] = [
  [[0, 0, 0], [0, 0, K]],
  [[0, 0, K], [m, 0, K]],
  [[0, 0, K], [0, T, K]],
];
const shownEdges: [P3, P3][] = [
  [[0, 0, 0], [m, 0, 0]],
  [[0, T, 0], [m, T, 0]],
  [[0, 0, 0], [0, T, 0]],
  [[m, 0, 0], [m, T, 0]],
  [[0, T, 0], [0, T, K]],
  [[m, T, 0], [m, T, K]],
  [[m, 0, 0], [m, 0, K]],
  [[0, T, K], [m, T, K]],
  [[m, 0, K], [m, T, K]],
];
const XY = (p: P3): Pt => pr(p);
const f0 = pr([0, 0, 0]);
const f1 = pr([m, 0, 0]);
const [tx1, ty1] = pr([0, 1, K]);
const [, ty2] = pr([0, m - 1, K]);
/* The free edges as slots: from the first to the last of their n − 2 nodes. */
const slots = [freeL, freeR].map((e) => {
  const [x, y1] = XY(e.at(-1)!);
  const [, y2] = XY(e[0]);
  return { x, y1, y2 };
});
const fy = (pr([0, 2, 0])[1] + pr([0, 3, 0])[1]) / 2 + 4;
const fl = f0[0];
const fr = f1[0];
const lx = 198;
const sx = lx + 7; // sample column of the list
const tx = lx + 18;
---

<svg class="pmf" viewBox="0 0 320 206" role="img" aria-labelledby="pmf-skeleton-t">
  <title id="pmf-skeleton-t">The cube with only its twelve edges filled in: 12n − 16 nodes on edges and corners, one H each, drawn for n = 6. The corner rod, of lone H's, fills nine edges: around the top face, down the back right edge, and around the bottom face, through all eight corners. The tenth-edge rod, ringed, fills the back left edge. The two free edges of the front face, on its left and right, stay empty for the walls; they are drawn as blue slots with empty nodes. The faces are pale and see-through, so the edges behind the cube show faded, their lines dashed.</title>
  {hiddenEdges.map(([a, b]) => <polyline class="pmf-slab-edge" stroke-dasharray="3 3" points={face([a, b])} />)}
  {corner.filter(hidden).map((p) => <Bead x={XY(p)[0]} y={XY(p)[1]} r={r} />)}
  {tenth.map((p) => <Bead x={XY(p)[0]} y={XY(p)[1]} r={r} />)}

  <g class="pmf-sk-glass">
    <polygon class="pmf-slab pmf-slab-top" points={face([[0, T, 0], [m, T, 0], [m, T, K], [0, T, K]])} />
    <polygon class="pmf-slab pmf-slab-side" points={face([[m, 0, 0], [m, 0, K], [m, T, K], [m, T, 0]])} />
    <polygon class="pmf-slab" points={face([[0, 0, 0], [m, 0, 0], [m, T, 0], [0, T, 0]])} />
  </g>
  <Ring x1={tx1} y1={ty1} y2={ty2} r={r} pad={2} dashed />
  {shownEdges.map(([a, b]) => <polyline class="pmf-slab-edge" points={face([a, b])} />)}
  {corner.filter((p) => !hidden(p)).map((p) => <Bead x={XY(p)[0]} y={XY(p)[1]} r={r} />)}

  <!-- the free edges -->
  {slots.map((sl) => <rect class="pmf-board" x={sl.x - r - 1.5} y={sl.y1 - r - 1.5} width={2 * r + 3} height={sl.y2 - sl.y1 + 2 * r + 3} rx={r + 1.5} />)}
  <Nodes pts={[...freeL, ...freeR].map(XY)} r={r} />
  <text class="pmf-label-accent pmf-sk-halo" x={(fl + fr) / 2} y={fy} text-anchor="middle">free edges</text>
  <path class="pmf-sk-lead" d={`M${(fl + fr) / 2 - 33} ${fy - 4}H${fl + r + 4}M${fl + r + 8} ${fy - 7}L${fl + r + 4} ${fy - 4}L${fl + r + 8} ${fy - 1}`} />
  <path class="pmf-sk-lead" d={`M${(fl + fr) / 2 + 33} ${fy - 4}H${fr - r - 4}M${fr - r - 8} ${fy - 7}L${fr - r - 4} ${fy - 4}L${fr - r - 8} ${fy - 1}`} />
  <path class="pmf-brace" d={hbrace(f0[0], f1[0], f0[1] + 7, 1)} />
  <Tx x={(f0[0] + f1[0]) / 2} y={f0[1] + 27} t={N.n} a="middle" />

  <Tx x={lx} y="40" t="edges and corners:" c="pmf-label-strong" />
  <Tx x={lx} y="54" t={`12${N.n} − 16 nodes,`} />
  <text class="pmf-label" x={lx} y="68">one H each</text>

  <Bead x={sx} y={94} r={r} />
  <text class="pmf-label" x={tx} y="98">{N.corner}</text>
  <text class="pmf-label-sm" x={tx} y="111">9 edges, 8 corners</text>

  <Bead x={sx} y={130} r={r} />
  <Ring x1={sx} y1={130} r={r} pad={2} dashed />
  <text class="pmf-label" x={tx} y="134">{N.tenth}</text>
  <text class="pmf-label-sm" x={tx} y="147">1 more edge</text>

  <rect class="pmf-board" x={sx - r - 1.5} y={160} width={2 * r + 3} height={20} rx={r + 1.5} />
  <Nodes pts={[[sx, 166], [sx, 174]]} r={r} />
  <text class="pmf-label-accent" x={tx} y="170">2 free edges</text>
  <text class="pmf-label-sm" x={tx} y="183">left for the walls</text>
</svg>

<style>
  .pmf-sk-glass {
    opacity: 0.72;
  }
  .pmf-sk-lead {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pmf-sk-halo {
    paint-order: stroke;
    stroke: var(--h-weak);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
</style>
