---
/**
 * The frame of every page: <head>, header with navigation, footer.
 * Navigation is generated from the sections collection (src/content/sections/*.mdx).
 */
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../data/site';
import { listedSections } from '../lib/sections';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** slug of the current section, to highlight it in the nav */
  current?: string;
}
const { title, description = SITE.tagline, current } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const sections = await listedSections();
const isHome = Astro.url.pathname === withBase('/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      // Light by default; apply a saved choice before first paint (no flash).
      let t = 'light';
      try {
        if (localStorage.getItem('theme') === 'dark') t = 'dark';
      } catch (e) {}
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <a class="skip ui" href="#main">Skip to content</a>
    <header class="site-header ui">
      <div class="inner">
        <a class="brand" href={withBase('/')}>
          <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 18 L4 12 L10 12 L10 6 L16 6 L16 12 L20 12" class="logo-chain" />
            <circle cx="4" cy="18" r="2.4" class="logo-p" />
            <circle cx="4" cy="12" r="2.4" class="logo-h" />
            <circle cx="10" cy="12" r="2.4" class="logo-h" />
            <circle cx="10" cy="6" r="2.4" class="logo-p" />
            <circle cx="16" cy="6" r="2.4" class="logo-p" />
            <circle cx="16" cy="12" r="2.4" class="logo-h" />
            <circle cx="20" cy="12" r="2.4" class="logo-p" />
          </svg>
          <span>{SITE.shortTitle}</span>
        </a>
        <button class="menu-toggle btn ghost" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <nav id="site-nav" aria-label="Sections">
          <ul>
            <li>
              <a href={withBase('/')} aria-current={isHome ? 'page' : undefined}>Home</a>
            </li>
            {
              sections.map((s) => (
                <li>
                  <a
                    href={withBase(`/${s.data.slug}/`)}
                    aria-current={current === s.data.slug ? 'page' : undefined}
                    class:list={[{ soon: s.data.status === 'soon' }]}
                  >
                    {s.data.navTitle ?? s.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <button class="theme-toggle btn ghost" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer ui">
      <div class="inner">
        <span>{SITE.event}</span>
        <span class="muted">
          Source: <a href={SITE.repoUrl}>repository</a>
        </span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      themeBtn?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        root.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      });

      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-nav');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
  }
  .skip:focus {
    left: var(--s-4);
    top: var(--s-2);
    z-index: 100;
    background: var(--bg-elev);
    padding: var(--s-2) var(--s-3);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .inner {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .site-header .inner {
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 650;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo {
    width: 24px;
    height: 24px;
  }
  .logo-chain {
    fill: none;
    stroke: var(--backbone);
    stroke-width: 1.4;
  }
  .logo-h {
    fill: var(--h);
  }
  .logo-p {
    fill: var(--bg);
    stroke: var(--p);
    stroke-width: 1.4;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-1);
  }
  nav li {
    margin: 0;
  }
  nav a {
    display: block;
    padding: 0.4em 0.65em;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--fg);
    background: var(--bg-sunk);
  }
  nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  nav a.soon {
    color: var(--fg-subtle);
  }
  .theme-toggle {
    padding: 0.45em;
    color: var(--fg-muted);
  }
  .menu-toggle {
    display: none;
  }

  @media (max-width: 62rem) {
    .menu-toggle {
      display: inline-flex;
    }
    nav {
      display: none;
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      padding: var(--s-2) var(--gutter) var(--s-4);
    }
    nav.open {
      display: flex;
    }
    nav ul {
      flex-direction: column;
    }
    nav a[aria-current='page'] {
      box-shadow: inset 2px 0 0 var(--accent);
    }
    .theme-toggle {
      align-self: flex-start;
    }
  }

  main {
    min-height: calc(100vh - var(--header-h) - 6rem);
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--s-8);
    color: var(--fg-muted);
  }
  .site-footer .inner {
    padding-block: var(--s-5);
    flex-wrap: wrap;
  }
</style>
